---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMetadata } from '../data/siteMetadata';
---

<BaseLayout
  title="Contact — Kanishk Roy | AI Content & Creative Production"
  description="Contact Kanishk Roy for AI-powered commercials, UGC, creative direction, and digital production systems."
>
  <div class="max-w-[1100px] mx-auto px-6 py-20 md:py-32 transition-colors">
    <div class="max-w-3xl">
      <div class="text-xs font-mono tracking-[0.24em] uppercase text-[#315CFF] font-bold mb-3">
        CONTACT // DIRECT INQUIRIES
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight leading-[1.02] mb-8 font-mono">
        LET'S MAKE SOMETHING.
      </h1>

      <p class="text-base sm:text-lg text-[#555555] dark:text-[#A0A09B] leading-relaxed mb-12 font-sans max-w-xl">
        Commercial campaigns, social-first UGC, and digital experiences combining creative direction with practical production systems.
      </p>

      <!-- Primary CTA Button -->
      <div class="mb-16">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="inline-flex items-center gap-2.5 px-8 py-4 rounded-md bg-[#111111] dark:bg-[#F3F1EC] text-[#F3F1EC] dark:text-[#111111] text-xs font-mono font-bold tracking-[0.16em] uppercase hover:bg-[#315CFF] dark:hover:bg-[#315CFF] hover:text-white dark:hover:text-white transition-all duration-200"
        >
          <span>GET IN TOUCH</span>
          <span class="text-sm">→</span>
        </a>
      </div>

      <!-- Professional Links -->
      <div class="pt-8 border-t border-[#D3D0C9] dark:border-[#26272B] flex flex-wrap items-center gap-6 sm:gap-10 text-xs font-mono">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          {siteMetadata.email} ↗
        </a>
        <a
          href={siteMetadata.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href={siteMetadata.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          GitHub ↗
        </a>
        <a
          href={siteMetadata.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          X (Twitter) ↗
        </a>
        <a
          href={siteMetadata.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          YouTube ↗
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
