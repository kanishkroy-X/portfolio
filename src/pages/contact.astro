---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMetadata } from '../data/siteMetadata';
---

<BaseLayout
  title="Contact | Kanishk Roy"
  description="Contact Kanishk Roy directly via email for digital product engineering, AI pipeline development, and commercial creative direction."
>
  <div class="max-w-[1100px] mx-auto px-6 py-16 md:py-24 transition-colors">
    <!-- Header Area: Contact + Short Statement -->
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-2 text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] tracking-[0.2em] uppercase font-bold mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3157FF] dark:bg-[#6B82FF]"></span>
        <span>CONTACT // DIRECT INQUIRIES</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.08] mb-6">
        Let's talk about what you are building.
      </h1>
      <p class="text-lg sm:text-xl text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
        I collaborate with founders, product teams, and brands looking to build resilient software systems or produce cutting-edge commercial video.
      </p>
    </div>

    <!-- Direct Email Action Box (Single Primary Action) -->
    <div class="relative rounded-2xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] p-8 sm:p-12 shadow-xs mb-12 transition-colors overflow-hidden">
      <!-- Corner Registration Marks -->
      <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#111111]/30 dark:border-[#F5F5F2]/30 pointer-events-none"></div>
      <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#111111]/30 dark:border-[#F5F5F2]/30 pointer-events-none"></div>
      <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#111111]/30 dark:border-[#F5F5F2]/30 pointer-events-none"></div>
      <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#111111]/30 dark:border-[#F5F5F2]/30 pointer-events-none"></div>

      <div class="max-w-xl">
        <div class="text-[11px] font-mono text-[#8E8E93] dark:text-[#777774] tracking-[0.15em] uppercase mb-2">
          PRIMARY ACTION
        </div>
        <div class="text-xs font-mono text-[#111111] dark:text-[#F5F5F2] font-semibold mb-6 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{siteMetadata.email}</span>
        </div>

        <!-- Single Primary Email CTA: Opens default mail application -->
        <a
          href={`mailto:${siteMetadata.email}`}
          class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[#111111] dark:bg-[#F5F5F2] text-white dark:text-[#111111] text-[15px] font-medium hover:bg-[#3157FF] dark:hover:bg-[#6B82FF] hover:text-white transition-all duration-200 shadow-md group focus:outline-none focus:ring-2 focus:ring-[#3157FF]"
        >
          <span>Open Mail App</span>
          <span class="text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>
    </div>

    <!-- Verified Social Media Accounts (Secondary Actions) -->
    <div class="mb-12">
      <div class="text-[11px] font-mono text-[#8E8E93] dark:text-[#777774] tracking-[0.15em] uppercase mb-4">
        CONNECTED PROFILES // SOCIAL &amp; CODE
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs font-mono">
        <!-- LinkedIn -->
        <a
          href={siteMetadata.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white/70 dark:bg-[#181818]/80 hover:border-[#111111] dark:hover:border-[#F5F5F2] transition-colors group flex flex-col justify-between"
        >
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase text-[10px] mb-2">Professional</div>
          <div class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mb-1 group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors flex items-center justify-between">
            <span>LinkedIn</span>
            <span class="text-[11px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </div>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans text-xs">Profile &amp; Network</p>
        </a>

        <!-- GitHub -->
        <a
          href={siteMetadata.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white/70 dark:bg-[#181818]/80 hover:border-[#111111] dark:hover:border-[#F5F5F2] transition-colors group flex flex-col justify-between"
        >
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase text-[10px] mb-2">Source Code</div>
          <div class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mb-1 group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors flex items-center justify-between">
            <span>GitHub</span>
            <span class="text-[11px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </div>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans text-xs">@kanishkroy-X</p>
        </a>

        <!-- X (Twitter) -->
        <a
          href={siteMetadata.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white/70 dark:bg-[#181818]/80 hover:border-[#111111] dark:hover:border-[#F5F5F2] transition-colors group flex flex-col justify-between"
        >
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase text-[10px] mb-2">Public Notes</div>
          <div class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mb-1 group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors flex items-center justify-between">
            <span>X / Twitter</span>
            <span class="text-[11px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </div>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans text-xs">@kanishkroy_</p>
        </a>

        <!-- YouTube -->
        <a
          href={siteMetadata.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white/70 dark:bg-[#181818]/80 hover:border-[#111111] dark:hover:border-[#F5F5F2] transition-colors group flex flex-col justify-between"
        >
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase text-[10px] mb-2">Creative Channel</div>
          <div class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mb-1 group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors flex items-center justify-between">
            <span>YouTube</span>
            <span class="text-[11px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </div>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans text-xs">Commercials &amp; Builds</p>
        </a>
      </div>
    </div>

    <!-- Small Context & Availability Meta -->
    <div class="pt-6 border-t border-[#DCDCD8]/60 dark:border-[#30302D]/60 flex flex-wrap items-center justify-between gap-4 text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>AVAILABLE FOR Q4 PRODUCT &amp; AI SYSTEMS</span>
        </span>
        <span class="text-[#DCDCD8] dark:text-[#30302D]">•</span>
        <span>TIMEZONE: IST (UTC +5:30)</span>
      </div>
      <div>
        <span>KOLKATA, IN // 22°34'N 88°22'E</span>
      </div>
    </div>
  </div>
</BaseLayout>
