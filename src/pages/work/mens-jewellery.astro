---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { aiContentProjects } from '../../data/projects';

const project = aiContentProjects.find(p => p.id === 'mens-jewellery')!;
---

<CaseStudyLayout project={project}>
  <!-- Hero Media Slot: Responsive 16:9 Click-to-Play Video Facade -->
  <div slot="hero-media" class="space-y-6">
    <div class="rounded-xl border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10] overflow-hidden shadow-2xl p-4 sm:p-8">
      <div class="flex items-center justify-between text-xs font-mono text-[#A0A09B] mb-4 pb-3 border-b border-[#26272B]">
        <span class="text-white font-semibold">MENS_JEWELLERY_COMMERCIAL_1080P</span>
        <span class="text-[#315CFF]">16:9 LUXURY COMMERCIAL MASTER</span>
      </div>

      <VideoFacade
        videoId="h6nyN1gyFvI"
        title="Men's Jewellery Luxury Commercial"
        posterJpg="/assets/projects/mens-jewellery/hero-poster.jpg"
        posterWebp="/assets/projects/mens-jewellery/hero-poster.webp"
        isVertical={false}
      />

      <div class="flex items-center justify-between text-[11px] font-mono text-[#A0A09B] mt-4 pt-3 border-t border-[#26272B]">
        <span>Macro Metal Physics &amp; Specular Reflections</span>
        <a
          href="https://www.youtube.com/watch?v=h6nyN1gyFvI"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#315CFF] hover:underline"
        >
          Watch on YouTube ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Pipeline Architecture Slot -->
  <div slot="diagram" class="space-y-6">
    <div class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold">
      PIPELINE ARCHITECTURE // MACRO SPECULAR LIGHTING &amp; CONSISTENCY
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#315CFF] font-bold mb-1">01 / CONSISTENCY</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">Multi-Angle Character Sheets</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          5-angle anchor references locking facial geometry, skin tones, and styling.
        </p>
      </div>

      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#315CFF] font-bold mb-1">02 / REFLECTION</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">Macro Glare Token Isolation</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          Decoupled specular reflection passes preventing link melting and temporal jitter.
        </p>
      </div>

      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#10B981] font-bold mb-1">03 / CONFORM</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">Studio Grade Assembly</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          Sub-5% curation gate with tactile metallic Foley mix and sub-bass dynamics.
        </p>
      </div>
    </div>
  </div>

  <!-- Evidence Slot: 6-Sheet Model & Prop Consistency Deck -->
  <div slot="evidence" class="space-y-6">
    <div class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold">
      6-SHEET MODEL &amp; PROP CONSISTENCY DECK
    </div>

    <!-- 6-Asset Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/character-1.webp"
          alt="Character Sheet Setup 01"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          01 // Master model portrait anchor
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/character-2.webp"
          alt="Character Sheet Setup 02"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          02 // 45° dark rim-light angle
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/character-3.webp"
          alt="Character Sheet Setup 03"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          03 // High-contrast low-key framing
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/character-4.webp"
          alt="Character Sheet Setup 04"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          04 // Macro chain focus pass
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/character-5.webp"
          alt="Character Sheet Setup 05"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          05 // Wardrobe &amp; posture lock
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/mens-jewellery/prop-macro.webp"
          alt="Jewelry Prop Macro Texture Reference"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          06 // Prop macro metallic pass
        </div>
      </div>
    </div>

    <!-- Technical Badges -->
    <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619] text-xs font-mono text-[#555555] dark:text-[#A0A09B] flex items-center justify-between">
      <span>1080P PRODUCTION MASTER // YOUTUBE STREAMING ACTIVE</span>
      <span class="text-[#10B981] font-semibold">VERIFIED EVIDENCE</span>
    </div>
  </div>
</CaseStudyLayout>
