---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'mens-jewellery')!;
---

<CaseStudyLayout project={project}>
  <!-- Technical Specular & Consistency Pipeline Diagram -->
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      PIPELINE ARCHITECTURE // MACRO SPECULAR LIGHTING &amp; CONSISTENCY
    </h2>
    
    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs font-mono">
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">STAGE 01</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Multi-Angle Character Sheets</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            5 camera-angle master references generated to establish invariant facial geometry, skin undertones, and wardrobe styling prior to video prompting.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">STAGE 02</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Macro Glare Token Isolation</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Decoupled specular reflection passes from metallic chain geometry prompts, forcing optical edge glints without surface melting.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#10B981] font-bold">STAGE 03</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Studio Grade Assembly</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Sub-5% curation gate feeding into timeline conforming in Premiere Pro with tactile metallic foley sound and sub-bass dynamics.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Character Sheets & Macro Prop Evidence -->
  <div slot="evidence" class="space-y-8">
    <div>
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-4">
        VERIFIED EVIDENCE // CHARACTER &amp; LIGHTING CONSISTENCY SHEETS
      </h2>
      <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] mb-6">
        Excerpts from the pre-production character sheet asset deck showing facial geometry consistency and dark studio rim-lighting calibration across multiple focal angles.
      </p>

      <!-- Image Grid of Character Sheets -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/character-1.webp"
            alt="Character Sheet Setup 01 - Primary Portrait"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Sheet 01: Master model portrait anchor
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/character-2.webp"
            alt="Character Sheet Setup 02 - Profile & Rim Lighting"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Sheet 02: 45-degree rim-light angle
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/character-3.webp"
            alt="Character Sheet Setup 03 - Dramatic Contrast"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Sheet 03: High-contrast low-key framing
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/character-4.webp"
            alt="Character Sheet Setup 04 - Macro Eye & Chain Focal Pass"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Sheet 04: Macro depth-of-field check
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/character-5.webp"
            alt="Character Sheet Setup 05 - Silhouette & Wardrobe Anchor"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Sheet 05: Wardrobe & necklace posture
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/mens-jewellery/prop-macro.webp"
            alt="Jewelry Prop Macro Texture Reference"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Prop Detail: Macro metallic surface pass
          </div>
        </div>
      </div>
    </div>

    <!-- Production Staging Notice -->
    <div class="p-6 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416] text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
        <span>PRODUCTION MASTER ARCHIVED // VIDEO STREAMING IN STAGING</span>
      </div>
      <span class="text-[#8E8E93] dark:text-[#777774]">4K MASTER ON DISK</span>
    </div>
  </div>
</CaseStudyLayout>
