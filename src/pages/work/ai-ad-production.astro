---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'ai-ad-production')!;
---

<CaseStudyLayout project={project}>
  <!-- Hero Media: Campaign 01 - Adidas Samba (9:16 Vertical Player) -->
  <div slot="hero-media" class="space-y-8">
    <div class="rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xl">
      <div class="px-4 py-3 bg-[#141416] border-b border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
          <span class="ml-2 text-white">ADIDAS_SAMBA_COMMERCIAL_1080P</span>
        </div>
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-semibold">CAMPAIGN 01 // 9:16 VERTICAL COMMERCIAL REEL</span>
      </div>

      <!-- YouTube Embed Container (9:16 Vertical) -->
      <div class="p-4 sm:p-8 flex items-center justify-center bg-black min-h-[440px] sm:min-h-[540px]">
        <div class="w-[270px] sm:w-[315px] aspect-[9/16] rounded-lg overflow-hidden shadow-2xl bg-black">
          <iframe
            src="https://www.youtube.com/embed/4SVc4FL4Mdk"
            title="AI Ad Production — Adidas Samba Commercial"
            class="w-full h-full border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="px-4 py-3 bg-[#141416] border-t border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
        <span>Authentic Campaign Master // 60fps Tumbled Leather Macro Focus</span>
        <span>9:16 Portrait Social Player</span>
      </div>
    </div>
  </div>

  <!-- Pipeline Graphic Slot -->
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      THE 13-STAGE COMMERCIAL PIPELINE ARCHITECTURE
    </h2>
    <div class="rounded-xl overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
      <img
        src="/assets/projects/ai-ad-production/pipeline-visual.svg"
        alt="13-Stage AI Commercial Production Framework Diagram"
        class="w-full h-auto"
      />
    </div>
    <p class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
      Figure 01: Multi-phase production pipeline establishing pre-visualization constraints prior to generative execution, followed by severe curation gates and frame-accurate timeline editing.
    </p>
  </div>

  <!-- Storyboard & Evidence Slot: Kreo Tech 16:9 Commercial + Storyboard + Post-Production Breakdown -->
  <div slot="evidence" class="space-y-12">
    <!-- Campaign 02: Kreo Tech 16:9 Widescreen Commercial -->
    <div>
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
        CAMPAIGN 02 // KREO TECH 16:9 WIDESCREEN NARRATIVE COMMERCIAL
      </h2>
      <div class="rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xl">
        <div class="px-4 py-3 bg-[#141416] border-b border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#3157FF] dark:bg-[#6B82FF]"></span>
            <span class="text-white">KREO_TECH_COMMERCIAL_16x9</span>
          </div>
          <span>16:9 WIDESCREEN CINEMATIC</span>
        </div>

        <!-- YouTube Embed Container (16:9 Widescreen) -->
        <div class="p-4 sm:p-6 bg-black flex items-center justify-center">
          <div class="w-full max-w-[780px] aspect-video rounded-lg overflow-hidden shadow-2xl bg-black">
            <iframe
              src="https://www.youtube.com/embed/cPhpFQnsXKo"
              title="AI Ad Production — Kreo Tech Commercial"
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <div class="px-4 py-3 bg-[#141416] border-t border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
          <span>Anamorphic Mechanical Hardware Stills // Matte Black &amp; Anodized Aluminum</span>
          <span>16:9 Widescreen Player</span>
        </div>
      </div>
      <p class="mt-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
        Figure 02: 16:9 widescreen narrative commercial produced for Kreo Tech hardware, demonstrating lighting stability across macro mechanical angles.
      </p>
    </div>

    <!-- Storyboard 2K -->
    <div>
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
        PRE-VISUALIZATION: ADIDAS SAMBA 2K STORYBOARD
      </h2>
      <div class="rounded-xl overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] p-3 shadow-xs transition-colors">
        <img
          src="/assets/projects/ai-ad-production/storyboard-samba.jpeg"
          alt="2K Storyboard sequence for Adidas sneaker commercial"
          class="w-full h-auto rounded-lg"
          loading="lazy"
        />
      </div>
      <p class="mt-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
        Figure 03: Real 2K resolution storyboard grid establishing focal lengths (50mm macro, 28mm dynamic action), camera blocking, and light angles before entering prompt engineering.
      </p>
    </div>

    <!-- Technical Post-Production Breakdown -->
    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <h3 class="text-base font-bold text-[#111111] dark:text-[#F5F5F2] mb-3">
        Post-Production Discipline in Premiere Pro &amp; CapCut
      </h3>
      <div class="space-y-4 text-sm text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
        <p>
          Generative AI clips provide raw footage plates, not finished films. Broadcast realism requires traditional editing discipline:
        </p>
        <ul class="space-y-2 list-disc list-inside">
          <li><strong>Sound Design &amp; Foley:</strong> Layered real rubber sole squeaks, mechanical switch clicks, ambient room reverb, and dynamic drops to ground synthetic visuals in physical acoustics.</li>
          <li><strong>Frame Pacing:</strong> Speed ramping between 120% and 80% to smooth micro-jitters in generative optical flow.</li>
          <li><strong>Color Grading:</strong> Custom LUTs applied across Midjourney, Runway, and Kling takes to unify white balance and contrast curves.</li>
        </ul>
      </div>
    </div>
  </div>
</CaseStudyLayout>
