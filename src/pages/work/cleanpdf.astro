---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'cleanpdf')!;
---

<CaseStudyLayout project={project}>
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      IN-BROWSER WEBASSEMBLY SANDBOX ARCHITECTURE
    </h2>
    <div class="rounded-xl overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
      <img
        src="/assets/projects/cleanpdf/architecture.svg"
        alt="CleanPDF In-Browser WebAssembly Architecture"
        class="w-full h-auto"
      />
    </div>
    <p class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
      Figure 01: Zero-server document execution running in sandboxed WebAssembly threads with client-side blob generation.
    </p>
  </div>
</CaseStudyLayout>
