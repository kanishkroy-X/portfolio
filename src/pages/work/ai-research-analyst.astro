---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'ai-research-analyst')!;
---

<CaseStudyLayout project={project}>
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      DETERMINISTIC VERIFICATION &amp; EXTRACTION PIPELINE
    </h2>
    <div class="rounded-xl overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
      <img
        src="/assets/projects/ai-research-analyst/architecture.svg"
        alt="AI Research Analyst Architecture"
        class="w-full h-auto"
      />
    </div>
    <p class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
      Figure 01: Multi-stage pipeline executing live web searches via Tavily, extracting verbatim source excerpts, and filtering output through a deterministic Verifier Gate to prune phantom citations.
    </p>
  </div>

  <div slot="evidence" class="space-y-8">
    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <h3 class="text-base font-bold text-[#111111] dark:text-[#F5F5F2] mb-3">
        Claim Taxonomy &amp; Evidence Grounding Rules
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
        <div class="p-3 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#10B981] font-bold">[ EVIDENCE ]</span>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] mt-1 font-sans">Strictly backed by verbatim extracted text from live web sources.</p>
        </div>
        <div class="p-3 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">[ INFERENCE ]</span>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] mt-1 font-sans">Synthesized conclusions derived directly from verified multi-source evidence.</p>
        </div>
        <div class="p-3 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#F59E0B] font-bold">[ ANALYSIS ]</span>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] mt-1 font-sans">Strategic interpretation; explicitly tagged when direct citations are absent.</p>
        </div>
        <div class="p-3 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#EF4444] font-bold">[ ASSUMPTION ]</span>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] mt-1 font-sans">Hypotheses and unverified market dynamics that require further testing.</p>
        </div>
      </div>
    </div>
  </div>
</CaseStudyLayout>
