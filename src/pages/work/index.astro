---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Selected Work & Systems Archive | Kanishk Roy"
  description="Comprehensive archive of digital products, real-time edge applications, AI commercial video pipelines, and research intelligence systems by Kanishk Roy."
>
  <div class="max-w-[1320px] mx-auto px-6 py-16 md:py-24 transition-colors">
    <!-- Archive Header -->
    <div class="max-w-3xl mb-16">
      <div class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] tracking-[0.2em] uppercase font-bold mb-3">
        SYSTEMS ARCHIVE // 2025–2026
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.08] mb-6">
        Selected Work
      </h1>
      <p class="text-lg sm:text-xl text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
        Production applications, generative AI video campaigns, and research engines built with an emphasis on evidence, speed, and real-world execution.
      </p>
    </div>

    <!-- Project Archive Grid -->
    <div class="space-y-12">
      {projects.map(project => (
        <article class="p-6 sm:p-10 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] hover:border-[#3157FF]/60 dark:hover:border-[#6B82FF]/60 hover:shadow-xs transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Media Preview -->
            <div class="lg:col-span-5 order-2 lg:order-1">
              <a href={`/work/${project.slug}`} class="block rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] aspect-[16/10] group">
                <img
                  src={project.heroMedia}
                  alt={project.title}
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </a>
            </div>

            <!-- Project Details -->
            <div class="lg:col-span-7 order-1 lg:order-2 flex flex-col justify-center">
              <div class="flex items-center gap-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] mb-2">
                <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">PROJECT {project.number}</span>
                <span>/</span>
                <span>{project.year}</span>
                <span>/</span>
                <span class="text-[#111111] dark:text-[#F5F5F2] font-semibold">{project.category}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold text-[#111111] dark:text-[#F5F5F2] mb-3">
                <a href={`/work/${project.slug}`} class="hover:text-[#3157FF] dark:hover:text-[#6B82FF] transition-colors">
                  {project.title}
                </a>
              </h2>

              <p class="text-sm sm:text-base text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed mb-6">
                {project.shortDescription}
              </p>

              <!-- Tech stack pills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {project.technologies.map(tech => (
                  <span class="text-[11.5px] font-mono px-2.5 py-1 rounded bg-[#F7F7F5] dark:bg-[#202020] border border-[#DCDCD8] dark:border-[#30302D] text-[#111111] dark:text-[#F5F5F2]">
                    {tech}
                  </span>
                ))}
              </div>

              <div>
                <a
                  href={`/work/${project.slug}`}
                  class="inline-flex items-center gap-2 text-sm font-mono font-semibold text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] group transition-colors"
                >
                  <span>View Case Study &amp; Architecture</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
