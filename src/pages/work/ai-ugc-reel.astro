---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'ai-ugc-reel')!;
---

<CaseStudyLayout project={project}>
  <!-- Pipeline Architecture Slot -->
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      PIPELINE ARCHITECTURE // MOBILE-FIRST AI UGC FRAMEWORK
    </h2>

    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs font-mono">
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">PHASE 01</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Multi-View Character Modeling</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Constructed strict 4-view character references to establish persistent creator facial landmarks, casual wardrobe, and skin pore fidelity.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">PHASE 02</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Smartphone Camera Simulation</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Injected natural handheld micro-drift, variable sensor exposure compensation, and domestic warm-tint ambient illumination tokens.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#10B981] font-bold">PHASE 03</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">9:16 Social Assembly</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Conformed sequence for TikTok and Instagram Reels pacing, layering realistic room acoustic reverberation and tactile Foley handling.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Character Sheets & Reference Card Evidence -->
  <div slot="evidence" class="space-y-8">
    <div>
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-4">
        VERIFIED EVIDENCE // CREATOR CHARACTER CONSISTENCY DECK
      </h2>
      <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] mb-6">
        Multi-angle reference sheets used to maintain facial structure, hair styling, and creator clothing texture across all synthetic takes without anatomical drift.
      </p>

      <!-- Image Grid of Character Sheets -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-1.webp"
            alt="Creator Consistency Sheet 01"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 01: Eye-level conversational anchor
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-2.webp"
            alt="Creator Consistency Sheet 02"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 02: Dynamic product handling pass
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-3.webp"
            alt="Creator Consistency Sheet 03"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 03: Profile cheekbone & expression
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-4.webp"
            alt="Creator Consistency Sheet 04"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 04: Three-quarter natural lighting
          </div>
        </div>
      </div>
    </div>

    <!-- Reference Card Highlight -->
    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-5 rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/reference-card.webp"
            alt="Creator Reference Card"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
        <div class="md:col-span-7 space-y-3">
          <span class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] font-bold">PRE-VISUALIZATION REF</span>
          <h3 class="text-xl font-bold text-[#111111] dark:text-[#F5F5F2]">Shot Composition &amp; Card Asset Ref</h3>
          <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
            Framing reference establishing the physical scale, hand interaction geometry, and focal distance for the synthetic creator's product demonstration gesture.
          </p>
        </div>
      </div>
    </div>

    <!-- Production Staging Notice -->
    <div class="p-6 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416] text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
        <span>PRODUCTION MASTER ARCHIVED // VIDEO STREAMING IN STAGING</span>
      </div>
      <span class="text-[#8E8E93] dark:text-[#777774]">9:16 VERTICAL MASTER ON DISK</span>
    </div>
  </div>
</CaseStudyLayout>
