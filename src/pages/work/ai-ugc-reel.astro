---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { aiContentProjects } from '../../data/projects';

const project = aiContentProjects.find(p => p.id === 'ai-ugc-reel')!;
---

<CaseStudyLayout project={project}>
  <!-- Hero Media Slot: Responsive 16:9 Click-to-Play Video Facade -->
  <div slot="hero-media" class="space-y-6">
    <div class="rounded-xl border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10] overflow-hidden shadow-2xl p-4 sm:p-8">
      <div class="flex items-center justify-between text-xs font-mono text-[#A0A09B] mb-4 pb-3 border-b border-[#26272B]">
        <span class="text-white font-semibold">AI_UGC_COMMERCIAL_SEQUENCE_1080P</span>
        <span class="text-[#315CFF]">16:9 COMMERCIAL MASTER</span>
      </div>

      <VideoFacade
        videoId="4OgE5mzghfI"
        title="AI UGC Commercial Sequence"
        posterJpg="/assets/projects/ai-ugc-reel/hero-poster.jpg"
        posterWebp="/assets/projects/ai-ugc-reel/hero-poster.webp"
        isVertical={false}
      />

      <div class="flex items-center justify-between text-[11px] font-mono text-[#A0A09B] mt-4 pt-3 border-t border-[#26272B]">
        <span>Handheld Smartphone Camera Physics &amp; Conversational Pacing</span>
        <a
          href="https://www.youtube.com/watch?v=4OgE5mzghfI"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#315CFF] hover:underline"
        >
          Watch on YouTube ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile-First UGC Pipeline Diagram Slot -->
  <div slot="diagram" class="space-y-6">
    <div class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold">
      MOBILE-FIRST UGC PIPELINE // NATURAL JITTER &amp; ROOM AMBIENCE
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#315CFF] font-bold mb-1">01 / CHARACTER</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">4-View Creator Deck</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          Locking skin undertones, hairline, and casual domestic wardrobe.
        </p>
      </div>

      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#315CFF] font-bold mb-1">02 / PHYSICS</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">Smartphone Camera Jitter</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          Simulated handheld micro-shake and organic focal breathing.
        </p>
      </div>

      <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]">
        <div class="text-[#10B981] font-bold mb-1">03 / CONVERSION</div>
        <div class="text-sm font-bold text-[#111111] dark:text-[#F3F1EC] mb-1 font-sans">Social Feed Edit</div>
        <p class="text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
          3-second hook structure, domestic Foley room tone, and rapid cut pacing.
        </p>
      </div>
    </div>
  </div>

  <!-- Evidence Slot: Creator Consistency Deck & Reference Framing -->
  <div slot="evidence" class="space-y-6">
    <div class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold">
      CREATOR CONSISTENCY DECK &amp; REFERENCE FRAMING
    </div>

    <!-- Image Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/ai-ugc-reel/character-1.webp"
          alt="Creator Character 01"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          01 // Direct-to-camera hook
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/ai-ugc-reel/character-2.webp"
          alt="Creator Character 02"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          02 // Domestic ambient light
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/ai-ugc-reel/character-3.webp"
          alt="Creator Character 03"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          03 // Conversational gesture
        </div>
      </div>

      <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
        <img
          src="/assets/projects/ai-ugc-reel/character-4.webp"
          alt="Creator Character 04"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="p-2.5 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
          04 // Product handover angle
        </div>
      </div>
    </div>

    <!-- Reference Card -->
    <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10]">
      <img
        src="/assets/projects/ai-ugc-reel/reference-card.webp"
        alt="Reference Card Calibration"
        class="w-full h-auto max-h-[400px] object-cover"
        loading="lazy"
      />
      <div class="p-3 bg-white/60 dark:bg-[#151619] border-t border-[#D3D0C9] dark:border-[#26272B] text-xs font-mono text-[#555555] dark:text-[#A0A09B] flex items-center justify-between">
        <span>Reference Framing &amp; Lighting Calibration</span>
        <span class="text-[#10B981] font-semibold">VERIFIED PIPELINE</span>
      </div>
    </div>
  </div>
</CaseStudyLayout>
