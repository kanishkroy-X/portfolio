---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.id === 'ai-ugc-reel')!;
---

<CaseStudyLayout project={project}>
  <!-- Hero Media Slot: 16:9 Click-to-Play Video Facade -->
  <div slot="hero-media" class="space-y-8">
    <div class="rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xl">
      <!-- Frame Top Bar -->
      <div class="px-4 py-3 bg-[#141416] border-b border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
          <span class="ml-2 text-white">AI_UGC_COMMERCIAL_SEQUENCE_1080P</span>
        </div>
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-semibold">16:9 COMMERCIAL MASTER</span>
      </div>

      <!-- Player Stage with Aspect Ratio 16/9 -->
      <div class="relative bg-black flex items-center justify-center p-3 sm:p-6 min-h-[320px] sm:min-h-[480px]">
        <div
          id="ugcVideoWrapper"
          class="w-full max-w-[960px] aspect-[16/9] rounded-lg overflow-hidden shadow-2xl bg-black relative"
        >
          <!-- Facade Poster (Click-to-Play) -->
          <div
            id="ugcVideoFacade"
            class="absolute inset-0 z-10 w-full h-full flex flex-col items-center justify-center cursor-pointer group/facade select-none overflow-hidden"
          >
            <picture>
              <source srcset="/assets/projects/ai-ugc-reel/hero-poster.webp" type="image/webp" />
              <img
                src="/assets/projects/ai-ugc-reel/hero-poster.jpg"
                alt="AI UGC Commercial Sequence Master Poster"
                class="absolute inset-0 w-full h-full object-cover brightness-95 group-hover/facade:scale-105 transition-transform duration-500 motion-reduce:transform-none"
                loading="eager"
                width="1440"
                height="810"
              />
            </picture>

            <!-- Vignette overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/45 group-hover/facade:from-black/75 transition-colors"></div>

            <!-- Interactive Trigger -->
            <button
              id="activateUgcVideoBtn"
              type="button"
              class="relative z-20 flex flex-col items-center gap-3 p-4 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF] rounded-2xl cursor-pointer"
              aria-label="Play AI UGC Commercial Sequence Master"
            >
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-black/60 backdrop-blur-md border border-white/25 flex items-center justify-center shadow-lg group-hover/facade:bg-[#3157FF] group-hover/facade:border-transparent group-hover/facade:scale-110 transition-all duration-300 motion-reduce:transition-none">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <div class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-[10.5px] font-mono tracking-wider uppercase text-white/90 group-hover/facade:text-white transition-colors">
                <span>▶ LOAD 1080P MASTER</span>
              </div>
            </button>

            <!-- Bottom Badges -->
            <div class="absolute bottom-3 inset-x-3 flex items-center justify-between text-[10px] font-mono text-white/70 pointer-events-none">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
                <span>STUDIO MASTER</span>
              </span>
              <span>16:9 SEQUENCE</span>
            </div>
          </div>

          <!-- Mount Point for YouTube IFrame -->
          <div id="ugcIframeMount" class="w-full h-full"></div>
        </div>
      </div>

      <!-- Frame Bottom Action Bar -->
      <div class="px-4 py-3 bg-[#141416] border-t border-[#262628] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-white/80">
        <div class="flex items-center gap-3">
          <span class="text-[#8E8E93]">Direct In-Page Player</span>
          <span class="text-[#262628]">•</span>
          <span class="text-[#10B981]">1080p Master</span>
        </div>
        <div>
          <a
            href="https://youtu.be/4OgE5mzghfI?si=DGmLsP9vXYCml0lp"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#3157FF] dark:text-[#6B82FF] hover:underline flex items-center gap-1"
          >
            <span>Watch on YouTube</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Pipeline Architecture Slot -->
  <div slot="diagram" class="space-y-6">
    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
      PIPELINE ARCHITECTURE // MOBILE-FIRST AI UGC FRAMEWORK
    </h2>

    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs font-mono">
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">PHASE 01</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Multi-View Character Modeling</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Constructed strict 4-view character references to establish persistent creator facial landmarks, casual wardrobe, and skin pore fidelity.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416]">
          <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">PHASE 02</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">Smartphone Camera Simulation</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Injected natural handheld micro-drift, variable sensor exposure compensation, and domestic warm-tint ambient illumination tokens.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-[#10B981] font-bold">
          <span class="text-[#10B981] font-bold">PHASE 03</span>
          <h3 class="text-sm font-bold text-[#111111] dark:text-[#F5F5F2] mt-1 mb-2 font-sans">16:9 Sequence Assembly</h3>
          <p class="text-[#6B6B6B] dark:text-[#A3A3A0] font-sans leading-relaxed">
            Conformed sequence for high-converting social pacing, layering realistic room acoustic reverberation and tactile Foley handling.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Character Sheets & Reference Card Evidence -->
  <div slot="evidence" class="space-y-8">
    <div>
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-4">
        VERIFIED EVIDENCE // CREATOR CHARACTER CONSISTENCY DECK
      </h2>
      <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] mb-6">
        Multi-angle reference sheets used to maintain facial structure, hair styling, and creator clothing texture across all synthetic takes without anatomical drift.
      </p>

      <!-- Image Grid of Character Sheets -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-1.webp"
            alt="Creator Consistency Sheet 01"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 01: Eye-level conversational anchor
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-2.webp"
            alt="Creator Consistency Sheet 02"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 02: Dynamic product handling pass
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-3.webp"
            alt="Creator Consistency Sheet 03"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 03: Profile cheekbone & expression
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/character-4.webp"
            alt="Creator Consistency Sheet 04"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="p-3 bg-white dark:bg-[#181818] border-t border-[#DCDCD8] dark:border-[#30302D] text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
            Angle 04: Three-quarter natural lighting
          </div>
        </div>
      </div>
    </div>

    <!-- Reference Card Highlight -->
    <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-5 rounded-lg overflow-hidden border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10]">
          <img
            src="/assets/projects/ai-ugc-reel/reference-card.webp"
            alt="Creator Reference Card"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
        <div class="md:col-span-7 space-y-3">
          <span class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] font-bold">PRE-VISUALIZATION REF</span>
          <h3 class="text-xl font-bold text-[#111111] dark:text-[#F5F5F2]">Shot Composition &amp; Card Asset Ref</h3>
          <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
            Framing reference establishing the physical scale, hand interaction geometry, and focal distance for the synthetic creator's product demonstration gesture.
          </p>
        </div>
      </div>
    </div>

    <!-- Verified Production Status -->
    <div class="p-6 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#F7F7F5] dark:bg-[#141416] text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
        <span>1080P PRODUCTION MASTER // YOUTUBE STREAMING ACTIVE</span>
      </div>
      <span class="text-[#8E8E93] dark:text-[#777774]">VERIFIED EVIDENCE</span>
    </div>
  </div>
</CaseStudyLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const facade = document.getElementById('ugcVideoFacade');
    const mount = document.getElementById('ugcIframeMount');
    const btn = document.getElementById('activateUgcVideoBtn');

    function activate() {
      if (!mount || mount.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/4OgE5mzghfI?autoplay=1';
      iframe.title = "AI UGC Commercial Sequence Master";
      iframe.className = 'w-full h-full border-0';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      mount.appendChild(iframe);
      if (facade) facade.style.display = 'none';
    }

    if (facade) facade.addEventListener('click', activate);
    if (btn) {
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    }
  });
</script>
