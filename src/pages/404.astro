---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Kanishk Roy"
  description="This page does not exist."
>
  <div class="min-h-[60vh] flex items-center justify-center px-6 py-20 transition-colors">
    <div class="max-w-md text-center">
      <div class="text-xs font-mono text-[#315CFF] uppercase tracking-[0.24em] font-bold mb-3">
        ERROR // 404
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[#111111] dark:text-[#F3F1EC] mb-4">
        This page doesn't exist.
      </h1>
      <p class="text-sm text-[#555555] dark:text-[#A0A09B] mb-8 font-mono">
        The requested resource is missing or has been relocated.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-[#111111] dark:bg-[#F3F1EC] text-[#F3F1EC] dark:text-[#111111] text-xs font-mono font-bold tracking-[0.14em] uppercase hover:bg-[#315CFF] dark:hover:bg-[#315CFF] hover:text-white dark:hover:text-white transition-colors"
      >
        <span>BACK TO HOMEPAGE</span>
        <span>→</span>
      </a>
    </div>
  </div>
</BaseLayout>
