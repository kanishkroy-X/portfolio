---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Project } from '../data/projects';
import { publicProjects } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Find next project in sequence from public projects
const currentIndex = project ? publicProjects.findIndex(p => p.id === project.id) : -1;
const safeIndex = currentIndex === -1 ? 0 : currentIndex;
const nextProject = publicProjects[(safeIndex + 1) % publicProjects.length];
---

<BaseLayout
  title={`${project.title} — Case Study | Kanishk Roy`}
  description={project.shortDescription}
  ogImage={project.heroMedia}
>
  <article class="pt-8 pb-24 md:pt-14 md:pb-32 transition-colors">
    <!-- Breadcrumbs / Top Bar -->
    <div class="max-w-[1100px] mx-auto px-6 mb-8">
      <div class="flex items-center justify-between text-xs font-mono text-[#555555] dark:text-[#A0A09B]">
        <a href="/work" class="hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors flex items-center gap-1.5">
          <span>←</span>
          <span>Back to Selected Work</span>
        </a>
        <span>PROJECT {project.number} // {project.year}</span>
      </div>
    </div>

    <!-- Project Header -->
    <header class="max-w-[1100px] mx-auto px-6 mb-12">
      <div class="inline-block mb-3">
        <span class="text-[11.5px] font-mono uppercase tracking-widest text-[#315CFF] font-semibold bg-[#315CFF]/10 px-3 py-1 rounded">
          {project.category}
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight leading-[1.05] mb-5">
        {project.title}
      </h1>

      <p class="text-xl sm:text-2xl text-[#555555] dark:text-[#A0A09B] font-normal leading-relaxed max-w-3xl mb-10 font-sans">
        {project.shortDescription}
      </p>

      <!-- Meta Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y border-[#D3D0C9] dark:border-[#26272B] text-xs font-mono">
        <div>
          <div class="text-[#7B8798] uppercase mb-1">Role</div>
          <div class="text-[#111111] dark:text-[#F3F1EC] font-medium">{project.role}</div>
        </div>
        <div>
          <div class="text-[#7B8798] uppercase mb-1">Timeline</div>
          <div class="text-[#111111] dark:text-[#F3F1EC] font-medium">{project.year}</div>
        </div>
        <div>
          <div class="text-[#7B8798] uppercase mb-1">Category</div>
          <div class="text-[#111111] dark:text-[#F3F1EC] font-medium">{project.category}</div>
        </div>
        <div>
          <div class="text-[#7B8798] uppercase mb-1">Status</div>
          <div class="text-[#10B981] font-medium">Verified Evidence</div>
        </div>
      </div>

      <!-- Tech Stack Spec -->
      <div class="mt-6 text-xs font-mono text-[#7B8798] dark:text-[#8E99A8] uppercase tracking-wider">
        <span class="text-[#111111] dark:text-[#F3F1EC] font-semibold mr-2">TECH SPEC //</span>
        {project.technologies.join('  •  ')}
      </div>
    </header>

    <!-- Hero Media Slot / Default Display -->
    <div class="max-w-[1100px] mx-auto px-6 mb-16">
      <slot name="hero-media">
        <div class="rounded-xl border border-[#D3D0C9] dark:border-[#26272B] overflow-hidden bg-[#0D0E10] shadow-sm">
          <img
            src={project.heroMedia}
            alt={project.title}
            class="w-full h-auto max-h-[640px] object-cover object-top"
          />
        </div>
      </slot>
    </div>

    <!-- Core Case Study Narrative Sections -->
    <div class="max-w-[900px] mx-auto px-6 space-y-14">
      <!-- 01 Overview -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold mb-3">
          01 // OVERVIEW
        </h2>
        <div class="text-lg text-[#111111] dark:text-[#F3F1EC] leading-relaxed font-sans">
          {project.description}
        </div>
      </section>

      <!-- 02 The Problem -->
      <section class="p-6 sm:p-8 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619] transition-colors">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#EF4444] font-bold mb-3">
          02 // THE PROBLEM
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F3F1EC] leading-relaxed font-sans">
          {project.problem}
        </div>
      </section>

      <!-- 03 The Approach -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold mb-3">
          03 // THE APPROACH &amp; STRATEGY
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F3F1EC] leading-relaxed font-sans">
          {project.approach}
        </div>
      </section>

      <!-- Slot for Custom Architecture or Process Diagram -->
      <slot name="diagram" />

      <!-- 04 Key Architectural Decisions -->
      {project.decisions && project.decisions.length > 0 && (
        <section>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#315CFF] font-bold mb-4">
            04 // KEY PRODUCTION &amp; DESIGN DECISIONS
          </h2>
          <div class="space-y-3">
            {project.decisions.map((decision, idx) => (
              <div class="p-4 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619] flex items-start gap-3 transition-colors">
                <span class="font-mono text-xs text-[#315CFF] font-bold mt-0.5">0{idx + 1}</span>
                <span class="text-sm text-[#111111] dark:text-[#F3F1EC] leading-relaxed">{decision}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Slot for Media Gallery or Supporting Screens -->
      <slot name="evidence" />

      <!-- 05 Result / Current State -->
      <section class="p-6 sm:p-8 rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-[#E7E4DE]/50 dark:bg-[#151619] transition-colors">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#10B981] font-bold mb-3">
          05 // OUTCOME &amp; PRODUCTION STATE
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F3F1EC] leading-relaxed font-sans">
          {project.outcome}
        </div>
      </section>

      <!-- 06 Key Learnings -->
      {project.learnings && project.learnings.length > 0 && (
        <section>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#7B8798] font-bold mb-3">
            06 // PRODUCTION LEARNINGS
          </h2>
          <div class="space-y-2 border-l-2 border-[#D3D0C9] dark:border-[#26272B] pl-4 text-sm text-[#555555] dark:text-[#A0A09B]">
            {project.learnings.map(learning => (
              <p>• {learning}</p>
            ))}
          </div>
        </section>
      )}

      <!-- External Links if any -->
      {project.externalLinks && project.externalLinks.length > 0 && (
        <section class="pt-6 border-t border-[#D3D0C9] dark:border-[#26272B]">
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#7B8798] font-bold mb-3">
            EXTERNAL REFERENCES
          </h2>
          <div class="flex flex-wrap gap-4">
            {project.externalLinks.map(link => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[#111111] dark:border-[#F3F1EC] bg-white/60 dark:bg-[#151619] text-xs font-mono font-medium hover:bg-[#111111] dark:hover:bg-[#F3F1EC] hover:text-white dark:hover:text-[#111111] transition-colors"
              >
                <span>{link.label}</span>
                <span>↗</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Next Project Navigation -->
    <div class="max-w-[1100px] mx-auto px-6 mt-20 pt-12 border-t border-[#D3D0C9] dark:border-[#26272B] transition-colors">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <div class="text-xs font-mono text-[#7B8798] uppercase mb-1">NEXT IN ARCHIVE</div>
          <a
            href={`/work/${nextProject.slug}`}
            class="text-2xl sm:text-3xl font-bold text-[#111111] dark:text-[#F3F1EC] hover:text-[#315CFF] transition-colors"
          >
            {nextProject.title} →
          </a>
        </div>
        <div>
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded border border-[#D3D0C9] dark:border-[#26272B] text-xs font-mono text-[#111111] dark:text-[#F3F1EC] hover:border-[#111111] dark:hover:border-[#F3F1EC] transition-colors"
          >
            Browse All Work
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
