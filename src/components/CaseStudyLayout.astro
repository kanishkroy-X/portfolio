---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Project } from '../data/projects';
import { projects } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Find next project in sequence
const currentIndex = projects.findIndex(p => p.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout
  title={`${project.title} — Case Study | Kanishk Roy`}
  description={project.shortDescription}
  ogImage={project.heroMedia}
>
  <article class="pt-8 pb-24 md:pt-14 md:pb-32 transition-colors">
    <!-- Breadcrumbs / Top Bar -->
    <div class="max-w-[1100px] mx-auto px-6 mb-8">
      <div class="flex items-center justify-between text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
        <a href="/work" class="hover:text-[#111111] dark:hover:text-[#F5F5F2] transition-colors flex items-center gap-1.5">
          <span>←</span>
          <span>Back to Selected Work</span>
        </a>
        <span>PROJECT {project.number} // {project.year}</span>
      </div>
    </div>

    <!-- Project Header -->
    <header class="max-w-[1100px] mx-auto px-6 mb-12">
      <div class="inline-block mb-3">
        <span class="text-[11.5px] font-mono uppercase tracking-widest text-[#3157FF] dark:text-[#6B82FF] font-semibold bg-[#3157FF]/10 dark:bg-[#6B82FF]/15 px-3 py-1 rounded">
          {project.category}
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.06] mb-6">
        {project.title}
      </h1>

      <p class="text-xl sm:text-2xl text-[#6B6B6B] dark:text-[#A3A3A0] font-normal leading-relaxed max-w-3xl mb-10">
        {project.shortDescription}
      </p>

      <!-- Meta Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y border-[#DCDCD8] dark:border-[#30302D] text-xs font-mono">
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">Role</div>
          <div class="text-[#111111] dark:text-[#F5F5F2] font-medium">{project.role}</div>
        </div>
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">Timeline</div>
          <div class="text-[#111111] dark:text-[#F5F5F2] font-medium">{project.year}</div>
        </div>
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">Category</div>
          <div class="text-[#111111] dark:text-[#F5F5F2] font-medium">{project.category}</div>
        </div>
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">Status</div>
          <div class="text-[#10B981] font-medium">Verified Evidence</div>
        </div>
      </div>

      <!-- Tech Stack Pills -->
      <div class="mt-6 flex flex-wrap gap-2">
        {project.technologies.map(tech => (
          <span class="px-2.5 py-1 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] text-xs font-mono text-[#111111] dark:text-[#F5F5F2]">
            {tech}
          </span>
        ))}
      </div>
    </header>

    <!-- Hero Media Slot / Default Display -->
    <div class="max-w-[1100px] mx-auto px-6 mb-16">
      <slot name="hero-media">
        <div class="rounded-xl border border-[#DCDCD8] dark:border-[#30302D] overflow-hidden bg-[#161618] shadow-xs">
          <img
            src={project.heroMedia}
            alt={project.title}
            class="w-full h-auto max-h-[640px] object-cover object-top"
          />
        </div>
      </slot>
    </div>

    <!-- Core Case Study Narrative Sections -->
    <div class="max-w-[900px] mx-auto px-6 space-y-16">
      <!-- 01 Overview -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
          01 // OVERVIEW
        </h2>
        <div class="text-lg text-[#111111] dark:text-[#F5F5F2] leading-relaxed font-sans">
          {project.description}
        </div>
      </section>

      <!-- 02 The Problem -->
      <section class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#EF4444] font-bold mb-3">
          02 // THE PROBLEM
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F5F5F2] leading-relaxed font-sans">
          {project.problem}
        </div>
      </section>

      <!-- 03 The Approach -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-3">
          03 // THE APPROACH &amp; STRATEGY
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F5F5F2] leading-relaxed font-sans">
          {project.approach}
        </div>
      </section>

      <!-- Slot for Custom Architecture or Process Diagram -->
      <slot name="diagram" />

      <!-- 04 Key Architectural Decisions -->
      {project.decisions && project.decisions.length > 0 && (
        <section>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#3157FF] dark:text-[#6B82FF] font-bold mb-4">
            04 // KEY TECHNICAL &amp; DESIGN DECISIONS
          </h2>
          <div class="space-y-3">
            {project.decisions.map((decision, idx) => (
              <div class="p-4 rounded-lg border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] flex items-start gap-3 transition-colors">
                <span class="font-mono text-xs text-[#3157FF] dark:text-[#6B82FF] font-bold mt-0.5">0{idx + 1}</span>
                <span class="text-sm text-[#111111] dark:text-[#F5F5F2] leading-relaxed">{decision}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Slot for Media Gallery or Supporting Screens -->
      <slot name="evidence" />

      <!-- 05 Result / Current State -->
      <section class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#FAFAF8] dark:bg-[#141416] transition-colors">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#10B981] font-bold mb-3">
          05 // OUTCOME &amp; PRODUCTION STATE
        </h2>
        <div class="text-base text-[#111111] dark:text-[#F5F5F2] leading-relaxed font-sans">
          {project.outcome}
        </div>
      </section>

      <!-- 06 Key Learnings -->
      {project.learnings && project.learnings.length > 0 && (
        <section>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#6B6B6B] dark:text-[#A3A3A0] font-bold mb-3">
            06 // ENGINEERING &amp; PRODUCT LEARNINGS
          </h2>
          <div class="space-y-2 border-l-2 border-[#DCDCD8] dark:border-[#30302D] pl-4 text-sm text-[#6B6B6B] dark:text-[#A3A3A0]">
            {project.learnings.map(learning => (
              <p>• {learning}</p>
            ))}
          </div>
        </section>
      )}

      <!-- External Links if any -->
      {project.externalLinks && project.externalLinks.length > 0 && (
        <section class="pt-6 border-t border-[#DCDCD8] dark:border-[#30302D]">
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#6B6B6B] dark:text-[#A3A3A0] font-bold mb-3">
            EXTERNAL REFERENCES &amp; ARTIFACTS
          </h2>
          <div class="flex flex-wrap gap-4">
            {project.externalLinks.map(link => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[#111111] dark:border-[#F5F5F2] bg-white dark:bg-[#181818] text-xs font-mono font-medium hover:bg-[#111111] dark:hover:bg-[#F5F5F2] hover:text-white dark:hover:text-[#111111] transition-colors"
              >
                <span>{link.label}</span>
                <span>↗</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Next Project Navigation -->
    <div class="max-w-[1100px] mx-auto px-6 mt-20 pt-12 border-t border-[#DCDCD8] dark:border-[#30302D] transition-colors">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <div class="text-xs font-mono text-[#8E8E93] dark:text-[#777774] uppercase">NEXT PROJECT ARCHIVE</div>
          <a
            href={`/work/${nextProject.slug}`}
            class="text-2xl sm:text-3xl font-bold text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] transition-colors"
          >
            {nextProject.title} →
          </a>
        </div>
        <div>
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#DCDCD8] dark:border-[#30302D] text-xs font-mono text-[#111111] dark:text-[#F5F5F2] hover:bg-white dark:hover:bg-[#181818] transition-colors"
          >
            Browse All 5 Projects
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
