---
import { projects } from '../data/projects';

const supportingProjects = projects.filter(p => !p.featured);
---

<section class="py-20 md:py-28 border-b border-[#DCDCD8] dark:border-[#30302D] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] tracking-[0.2em] uppercase font-bold mb-2">
          03 // SELECTED ARCHIVE
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight">
          Supporting Work &amp; Applied Systems
        </h2>
      </div>
      <p class="text-sm font-mono text-[#6B6B6B] dark:text-[#A3A3A0] max-w-sm">
        Tailored technical and UX solutions built for specific operational bottlenecks.
      </p>
    </div>

    <!-- Editorial Project Table / Rows -->
    <div class="border-t border-[#DCDCD8] dark:border-[#30302D] divide-y divide-[#DCDCD8] dark:divide-[#30302D] transition-colors">
      {supportingProjects.map((item) => (
        <a
          href={`/work/${item.slug}`}
          class="group block py-8 sm:py-10 transition-colors hover:bg-white/70 dark:hover:bg-[#181818]/70 px-4 -mx-4 rounded-lg"
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-start md:items-center">
            <!-- Project Number & Category -->
            <div class="md:col-span-3 flex items-center gap-3 font-mono text-xs text-[#6B6B6B] dark:text-[#A3A3A0]">
              <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold text-sm">{item.number}</span>
              <span class="text-[#DCDCD8] dark:text-[#30302D]">/</span>
              <span class="tracking-wider uppercase">{item.category}</span>
            </div>

            <!-- Title & Short Description -->
            <div class="md:col-span-6">
              <h3 class="text-xl sm:text-2xl font-bold text-[#111111] dark:text-[#F5F5F2] group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
                {item.shortDescription}
              </p>
            </div>

            <!-- Year, Tech & Action Arrow -->
            <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-6 text-xs font-mono">
              <span class="text-[#6B6B6B] dark:text-[#A3A3A0]">{item.year}</span>
              <span class="inline-flex items-center gap-1 font-semibold text-[#111111] dark:text-[#F5F5F2] group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors">
                <span>View Project</span>
                <span class="text-sm group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Link to Full Work Index -->
    <div class="mt-12 text-center sm:text-left">
      <a
        href="/work"
        class="inline-flex items-center gap-2 text-sm font-mono text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] font-semibold transition-colors"
      >
        <span>Browse Complete Selected Work Archive</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>
