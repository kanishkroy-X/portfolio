---
interface Props {
  videoId: string;
  title: string;
  posterJpg: string;
  posterWebp?: string;
  aspectRatio?: '16/9' | '9/16';
  isVertical?: boolean;
  class?: string;
}

const {
  videoId,
  title,
  posterJpg,
  posterWebp,
  aspectRatio = '16/9',
  isVertical = false,
  class: className = '',
} = Astro.props;

const uniqueId = `facade-${videoId.replace(/[^a-zA-Z0-9]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
---

<div
  class={`relative w-full rounded-lg overflow-hidden bg-[#0D0E10] border border-[#26272B] shadow-lg group/video ${className}`}
  data-video-facade
  data-video-id={videoId}
  data-video-title={title}
  id={uniqueId}
>
  <!-- Responsive container -->
  <div class={`relative w-full flex items-center justify-center bg-black ${isVertical ? 'aspect-[9/16] max-w-[340px] mx-auto' : 'aspect-video'}`}>
    <!-- Click-to-Play Facade Layer -->
    <div
      class="facade-overlay absolute inset-0 z-10 w-full h-full flex flex-col items-center justify-center cursor-pointer select-none overflow-hidden"
      role="button"
      tabindex="0"
      aria-label={`Play video: ${title}`}
    >
      <picture>
        {posterWebp && <source srcset={posterWebp} type="image/webp" />}
        <img
          src={posterJpg}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover filter brightness-95 group-hover/video:scale-105 transition-transform duration-700 motion-reduce:transform-none"
          loading="lazy"
          decoding="async"
        />
      </picture>

      <!-- Vignette -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/40 group-hover/video:from-black/70 transition-colors"></div>

      <!-- Play Trigger Button -->
      <div class="relative z-20 flex flex-col items-center gap-2 p-3 text-white pointer-events-none">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-black/60 backdrop-blur-md border border-white/25 flex items-center justify-center shadow-xl group-hover/video:bg-[#315CFF] group-hover/video:border-transparent group-hover/video:scale-110 transition-all duration-300">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white fill-current translate-x-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <div class="px-3 py-1 rounded bg-black/75 backdrop-blur-md border border-white/20 text-[10px] font-mono tracking-widest uppercase text-white/90 group-hover/video:text-white transition-colors">
          PLAY MASTER
        </div>
      </div>

      <!-- Bottom Status Tag -->
      <div class="absolute bottom-2.5 inset-x-3 flex items-center justify-between text-[10px] font-mono text-white/70 pointer-events-none">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
          <span>1080P MASTER</span>
        </span>
        <span>{isVertical ? '9:16 VERTICAL' : '16:9 CINEMATIC'}</span>
      </div>
    </div>

    <!-- Mount Point for IFrame -->
    <div class="iframe-container w-full h-full"></div>
  </div>
</div>

<script>
  function setupFacades() {
    document.querySelectorAll('[data-video-facade]').forEach((wrapper) => {
      if (wrapper.getAttribute('data-initialized')) return;
      wrapper.setAttribute('data-initialized', 'true');

      const overlay = wrapper.querySelector('.facade-overlay');
      const mount = wrapper.querySelector('.iframe-container');
      const videoId = wrapper.getAttribute('data-video-id');
      const title = wrapper.getAttribute('data-video-title') || 'Video player';

      function play() {
        if (!mount || !videoId || mount.querySelector('iframe')) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.title = title;
        iframe.className = 'w-full h-full border-0';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        mount.appendChild(iframe);
        if (overlay) (overlay as HTMLElement).style.display = 'none';
        iframe.focus();
      }

      if (overlay) {
        overlay.addEventListener('click', play);
        overlay.addEventListener('keydown', (e) => {
          const keyEvent = e as KeyboardEvent;
          if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
            keyEvent.preventDefault();
            play();
          }
        });
      }
    });
  }

  setupFacades();
  document.addEventListener('astro:page-load', setupFacades);
</script>
