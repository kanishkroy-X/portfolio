---
const capabilities = [
  'AI VIDEO',
  'CREATIVE DIRECTION',
  'AI UGC',
  'VIDEO EDITING',
  'PRODUCT THINKING',
  'PROTOTYPING'
];
---

<section id="about" class="py-20 md:py-28 border-b border-[#D3D0C9] dark:border-[#26272B] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Left: Prominent Portrait -->
      <div class="lg:col-span-5">
        <div class="rounded-lg overflow-hidden border border-[#D3D0C9] dark:border-[#26272B] bg-[#E7E4DE] dark:bg-[#151619] p-2 shadow-xs">
          <div class="relative overflow-hidden rounded aspect-[4/5] bg-[#0D0E10]">
            <picture>
              <source srcset="/assets/personal/kanishk-portrait.webp" type="image/webp" />
              <img
                src="/assets/personal/kanishk-portrait.jpg"
                alt="Kanishk Roy — AI Content & Creative Production"
                class="w-full h-full object-cover object-top filter grayscale contrast-[1.05]"
                loading="lazy"
                width="800"
                height="1000"
              />
            </picture>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[10px] font-mono text-white/90 bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded">
              <span>KANISHK ROY</span>
              <span>KOLKATA, IN</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Short Statement & Capabilities -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <div class="text-xs font-mono tracking-[0.24em] uppercase text-[#315CFF] font-bold mb-3">
          04 // ABOUT
        </div>

        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight mb-2">
          KANISHK ROY
        </h2>

        <div class="text-base sm:text-lg font-mono font-bold tracking-[0.1em] uppercase text-[#555555] dark:text-[#A0A09B] mb-6">
          AI CONTENT / CREATIVE PRODUCTION
        </div>

        <p class="text-lg sm:text-xl text-[#111111] dark:text-[#F3F1EC] leading-relaxed mb-10 font-sans max-w-xl">
          I create AI-powered commercials, UGC and digital experiences, combining creative direction with practical production systems.
        </p>

        <!-- Capabilities Editorial Index -->
        <div class="pt-2">
          <div class="text-xs font-mono uppercase tracking-[0.2em] text-[#555555] dark:text-[#A0A09B] font-semibold mb-4">
            CAPABILITIES
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2.5 gap-x-8 border-t border-[#D3D0C9] dark:border-[#26272B] pt-4">
            {capabilities.map((cap, idx) => (
              <div class="flex items-center justify-between py-2 border-b border-[#D3D0C9]/40 dark:border-[#26272B]/60 font-mono text-xs text-[#111111] dark:text-[#F3F1EC] tracking-wider uppercase">
                <span class="text-[#7B8798] dark:text-[#8E99A8] text-[10px]">0{idx + 1} //</span>
                <span class="font-semibold">{cap}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
