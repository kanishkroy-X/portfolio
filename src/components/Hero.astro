---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 border-b border-[#D3D0C9] dark:border-[#26272B] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Left Column: Typography & CTAs -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Eyebrow -->
        <div class="text-[12px] font-mono tracking-[0.24em] uppercase text-[#555555] dark:text-[#A0A09B] font-semibold mb-4">
          PORTFOLIO // 2026
        </div>

        <!-- Name -->
        <h1 class="text-4xl sm:text-6xl lg:text-[72px] font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-[-0.035em] leading-[1.02] mb-5">
          KANISHK ROY
        </h1>

        <!-- Primary Positioning -->
        <div class="text-xl sm:text-2xl lg:text-[26px] font-mono font-bold tracking-[0.08em] text-[#111111] dark:text-[#F3F1EC] uppercase mb-4">
          AI CONTENT / CREATIVE PRODUCTION
        </div>

        <!-- Supporting Line -->
        <p class="text-base sm:text-lg text-[#555555] dark:text-[#A0A09B] leading-relaxed max-w-[540px] mb-8 font-sans">
          AI-powered commercials, UGC &amp; visual experiences. Combining creative direction with production systems and product thinking.
        </p>

        <!-- Minimal CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#ai-content"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-[#111111] dark:bg-[#F3F1EC] text-[#F3F1EC] dark:text-[#111111] text-xs font-mono font-bold tracking-[0.14em] uppercase hover:bg-[#315CFF] dark:hover:bg-[#315CFF] hover:text-white dark:hover:text-white transition-all duration-200"
          >
            <span>VIEW WORK</span>
            <span class="text-sm">→</span>
          </a>

          <a
            href="#about"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-md border border-[#D3D0C9] dark:border-[#26272B] bg-white/40 dark:bg-[#151619]/60 text-[#111111] dark:text-[#F3F1EC] text-xs font-mono font-semibold tracking-[0.14em] uppercase hover:border-[#111111] dark:hover:border-[#F3F1EC] transition-all duration-200"
          >
            <span>ABOUT</span>
            <span class="text-sm">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Visual Frame with Portrait -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-[#E7E4DE] dark:bg-[#151619] p-2 shadow-xs overflow-hidden">
          <div class="relative overflow-hidden rounded aspect-[4/3] bg-[#0D0E10]">
            <picture>
              <source srcset="/assets/personal/kanishk-portrait.webp" type="image/webp" />
              <img
                src="/assets/personal/kanishk-portrait.jpg"
                alt="Portrait of Kanishk Roy — AI Content & Creative Production"
                class="w-full h-full object-cover object-top filter grayscale contrast-[1.05] transition-transform duration-700 hover:scale-[1.02]"
                loading="eager"
                width="1024"
                height="682"
              />
            </picture>

            <!-- Bottom Frame Subtle Label -->
            <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-[10px] font-mono text-white/90">
              <span class="flex items-center gap-1.5 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-[#315CFF]"></span>
                <span class="tracking-wider">KANISHK ROY</span>
              </span>
              <span class="tracking-widest uppercase text-white/70 text-[9.5px] shrink-0 text-right">CREATIVE DIRECTION</span>
            </div>
          </div>

          <!-- Technical Sub-caption -->
          <div class="mt-2 px-1 flex items-center justify-between text-[10.5px] font-mono text-[#555555] dark:text-[#A0A09B]">
            <span>FIG 01 // IDENTITY</span>
            <span>KOLKATA, IN</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
