---
interface Props {
  className?: string;
  compact?: boolean;
}

const { className = '', compact = false } = Astro.props;
---

<div
  class={`theme-switcher-container inline-flex items-center p-0.5 rounded-full border border-[#DCDCD8] dark:border-[#30302D] bg-[#EFEFEA]/80 dark:bg-[#181818]/90 text-[11px] font-mono transition-colors ${className}`}
  role="radiogroup"
  aria-label="Color theme selection"
>
  <!-- System / Auto Option -->
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="system"
    class="theme-toggle-btn flex items-center gap-1 px-2 py-1 rounded-full text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2] transition-all focus-visible:ring-1 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF]"
    title="System preference (auto)"
    aria-label="System theme"
  >
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
      <line x1="8" y1="21" x2="16" y2="21"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
    </svg>
    <span class={compact ? 'sr-only' : 'hidden sm:inline'}>Auto</span>
  </button>

  <!-- Light Theme Option -->
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="light"
    class="theme-toggle-btn flex items-center gap-1 px-2 py-1 rounded-full text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2] transition-all focus-visible:ring-1 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF]"
    title="Light theme"
    aria-label="Light theme"
  >
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <span class={compact ? 'sr-only' : 'hidden sm:inline'}>Light</span>
  </button>

  <!-- Dark Theme Option -->
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="dark"
    class="theme-toggle-btn flex items-center gap-1 px-2 py-1 rounded-full text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2] transition-all focus-visible:ring-1 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF]"
    title="Dark theme"
    aria-label="Dark theme"
  >
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
    <span class={compact ? 'sr-only' : 'hidden sm:inline'}>Dark</span>
  </button>
</div>

<script is:inline>
  (function() {
    function initThemeSwitchers() {
      const currentStored = localStorage.getItem('theme') || 'system';

      function applyTheme(target) {
        localStorage.setItem('theme', target);
        document.documentElement.setAttribute('data-theme', target);

        const isDark = target === 'dark' || (target === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // Update all theme switcher buttons on the page
        document.querySelectorAll('.theme-switcher-container').forEach(container => {
          container.querySelectorAll('.theme-toggle-btn').forEach(btn => {
            const val = btn.getAttribute('data-theme-value');
            const isActive = val === target;
            btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
            if (isActive) {
              btn.classList.add('bg-white', 'dark:bg-[#202020]', 'text-[#111111]', 'dark:text-[#F5F5F2]', 'shadow-xs', 'font-medium');
              btn.classList.remove('text-[#6B6B6B]', 'dark:text-[#A3A3A0]');
            } else {
              btn.classList.remove('bg-white', 'dark:bg-[#202020]', 'text-[#111111]', 'dark:text-[#F5F5F2]', 'shadow-xs', 'font-medium');
              btn.classList.add('text-[#6B6B6B]', 'dark:text-[#A3A3A0]');
            }
          });
        });
      }

      // Initial active state update
      applyTheme(currentStored);

      // Attach click handlers
      document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
        btn.onclick = function() {
          const val = this.getAttribute('data-theme-value');
          if (val) {
            applyTheme(val);
          }
        };
      });

      // Listen for OS scheme change if system mode
      if (!window._themeMediaListenerAttached) {
        window._themeMediaListenerAttached = true;
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (localStorage.getItem('theme') === 'system') {
            if (e.matches) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeSwitchers);
    } else {
      initThemeSwitchers();
    }
  })();
</script>
