---
import { projects } from '../data/projects';

const project = projects.find(p => p.id === 'ai-ad-production')!;
---

<section class="py-20 md:py-28 border-b border-[#DCDCD8] dark:border-[#30302D] bg-[#FAFAF8] dark:bg-[#141416] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <!-- Section Eyebrow -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] tracking-[0.2em] uppercase">
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">02 // FEATURED CREATIVE SYSTEM</span>
        <span class="text-[#DCDCD8] dark:text-[#30302D]">/</span>
        <span>AI PRODUCTION PILLAR</span>
      </div>
      <span class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase">TWO HERO CAMPAIGNS</span>
    </div>

    <!-- Main Feature Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Left Column: Context & 13-Stage Pipeline -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="inline-block mb-3">
          <span class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#3157FF] dark:text-[#6B82FF] font-semibold bg-[#3157FF]/10 dark:bg-[#6B82FF]/15 px-2.5 py-1 rounded">
            {project.category}
          </span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.1] mb-4">
          <a href={`/work/${project.slug}`} class="hover:text-[#3157FF] dark:hover:text-[#6B82FF] transition-colors">
            {project.title}
          </a>
        </h2>

        <p class="text-[17px] text-[#111111] dark:text-[#F5F5F2] font-medium mb-3">
          Commercial-grade video campaigns powered by rigorous prompt architecture.
        </p>

        <p class="text-[15.5px] text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed mb-6">
          {project.description}
        </p>

        <!-- Two Commercial Formats Selection Tabs -->
        <div class="mb-6 flex items-center gap-2 font-mono text-xs">
          <button
            type="button"
            id="tabAdidasBtn"
            class="px-3.5 py-2 rounded-md bg-[#111111] dark:bg-[#F5F5F2] text-white dark:text-[#111111] font-medium cursor-pointer transition-colors shadow-xs"
          >
            01 / ADIDAS SAMBA (9:16)
          </button>
          <button
            type="button"
            id="tabKreoBtn"
            class="px-3.5 py-2 rounded-md bg-white dark:bg-[#181818] border border-[#DCDCD8] dark:border-[#30302D] text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2] font-medium cursor-pointer transition-colors"
          >
            02 / KREO TECH (16:9)
          </button>
        </div>

        <!-- The 13-Stage Pipeline Mini Visual -->
        <div class="mb-8 p-4 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
          <div class="flex items-center justify-between text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase tracking-wider mb-2">
            <span>Verified 13-Stage Pipeline:</span>
            <span class="text-[#3157FF] dark:text-[#6B82FF]">PROVEN WORKFLOW</span>
          </div>
          <div class="text-[12px] font-mono text-[#111111] dark:text-[#F5F5F2] leading-relaxed">
            BRIEF → POSITIONING → 2K STORYBOARD → PROMPT ARCH → MULTI-SEED GEN → SELECTION GATE → EDITORIAL → SOUND DESIGN → QA MASTER
          </div>
        </div>

        <!-- Featured Campaigns Evidence -->
        <div class="space-y-2 mb-8 border-l-2 border-[#DCDCD8] dark:border-[#30302D] pl-4 text-xs sm:text-[13px] text-[#6B6B6B] dark:text-[#A3A3A0]">
          <div>• <strong>Adidas Samba</strong>: 9:16 vertical commercial reel with leather texture retention.</div>
          <div>• <strong>Kreo Tech</strong>: 16:9 widescreen narrative product commercial exploring mechanical hardware.</div>
          <div>• <strong>2K Storyboards</strong>: Strict focal length blocking before generative iterations.</div>
        </div>

        <!-- CTA Link -->
        <div>
          <a
            href={`/work/${project.slug}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] group transition-colors"
          >
            <span>View Full Case Study &amp; Production Pipeline</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Dual Commercial Showcase -->
      <div class="lg:col-span-7">
        <div class="relative rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xs">
          <!-- Frame Header -->
          <div class="px-4 py-2.5 bg-[#141416] border-b border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
              <span id="campaignTitleLabel" class="ml-2 text-white">ADIDAS_SAMBA_COMMERCIAL_1080P</span>
            </div>
            <span id="campaignFormatLabel">9:16 COMMERCIAL REEL</span>
          </div>

          <!-- Campaign Player Stage -->
          <div class="relative bg-black flex items-center justify-center p-4 sm:p-6 min-h-[440px] sm:min-h-[520px]">
            <!-- Responsive Wrapper for YouTube Embed -->
            <div id="playerWrapper" class="w-[270px] sm:w-[310px] aspect-[9/16] rounded-lg overflow-hidden shadow-2xl bg-black transition-all duration-300">
              <iframe
                id="campaignIframe"
                src="https://www.youtube.com/embed/4SVc4FL4Mdk"
                title="AI Ad Production — Adidas Samba Commercial"
                class="w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>

          <!-- Video Frame Action Bar -->
          <div class="px-4 py-3 bg-[#141416] border-t border-[#262628] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-white/80">
            <div class="flex items-center gap-3">
              <span class="text-[#8E8E93]">Direct In-Page Player</span>
              <span class="text-[#262628]">•</span>
              <span class="text-[#10B981]">1080p Masters</span>
            </div>
            <div class="flex items-center gap-3">
              <a
                href="/assets/projects/ai-ad-production/storyboard-samba.jpeg"
                target="_blank"
                class="text-[#3157FF] dark:text-[#6B82FF] hover:underline"
              >
                [ Storyboard 2K ]
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Commercial Switcher Controls for YouTube Embeds
  const playerWrapper = document.getElementById('playerWrapper');
  const iframe = document.getElementById('campaignIframe') as HTMLIFrameElement | null;
  const titleLabel = document.getElementById('campaignTitleLabel');
  const formatLabel = document.getElementById('campaignFormatLabel');
  const tabAdidas = document.getElementById('tabAdidasBtn');
  const tabKreo = document.getElementById('tabKreoBtn');

  const campaigns = {
    adidas: {
      title: 'ADIDAS_SAMBA_COMMERCIAL_1080P',
      format: '9:16 COMMERCIAL REEL',
      src: 'https://www.youtube.com/embed/4SVc4FL4Mdk',
      iframeTitle: 'AI Ad Production — Adidas Samba Commercial',
      wrapperClasses: 'w-[270px] sm:w-[310px] aspect-[9/16] rounded-lg overflow-hidden shadow-2xl bg-black transition-all duration-300'
    },
    kreo: {
      title: 'KREO_TECH_COMMERCIAL_16X9',
      format: '16:9 WIDESCREEN FILM',
      src: 'https://www.youtube.com/embed/cPhpFQnsXKo',
      iframeTitle: 'AI Ad Production — Kreo Tech Commercial',
      wrapperClasses: 'w-full max-w-[620px] aspect-video rounded-lg overflow-hidden shadow-2xl bg-black transition-all duration-300'
    }
  };

  let activeCampaign: 'adidas' | 'kreo' = 'adidas';

  const switchCampaign = (key: 'adidas' | 'kreo') => {
    if (activeCampaign === key || !iframe || !playerWrapper) return;
    activeCampaign = key;

    const data = campaigns[key];
    iframe.src = data.src;
    iframe.title = data.iframeTitle;
    playerWrapper.className = data.wrapperClasses;

    if (titleLabel) titleLabel.textContent = data.title;
    if (formatLabel) formatLabel.textContent = data.format;

    const activeClasses = ['bg-[#111111]', 'dark:bg-[#F5F5F2]', 'text-white', 'dark:text-[#111111]'];
    const inactiveClasses = ['bg-white', 'dark:bg-[#181818]', 'border', 'border-[#DCDCD8]', 'dark:border-[#30302D]', 'text-[#6B6B6B]', 'dark:text-[#A3A3A0]'];

    if (key === 'adidas') {
      tabAdidas?.classList.remove(...inactiveClasses);
      tabAdidas?.classList.add(...activeClasses);
      tabKreo?.classList.remove(...activeClasses);
      tabKreo?.classList.add(...inactiveClasses);
    } else {
      tabKreo?.classList.remove(...inactiveClasses);
      tabKreo?.classList.add(...activeClasses);
      tabAdidas?.classList.remove(...activeClasses);
      tabAdidas?.classList.add(...inactiveClasses);
    }
  };

  if (tabAdidas) tabAdidas.addEventListener('click', () => switchCampaign('adidas'));
  if (tabKreo) tabKreo.addEventListener('click', () => switchCampaign('kreo'));
</script>
