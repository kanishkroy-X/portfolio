---
import { projects } from '../data/projects';

const project = projects.find(p => p.id === 'ai-ad-production')!;
---

<section id="ai-ad-studio" class="py-20 md:py-28 border-b border-[#DCDCD8] dark:border-[#30302D] bg-[#FAFAF8] dark:bg-[#141416] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <!-- Section Eyebrow -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] tracking-[0.2em] uppercase">
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">02 // FEATURED CREATIVE SYSTEM</span>
        <span class="text-[#DCDCD8] dark:text-[#30302D]">/</span>
        <span>AI PRODUCTION PILLAR</span>
      </div>
      <span class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase">TWO HERO CAMPAIGNS</span>
    </div>

    <!-- Main Feature Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Left Column: Context & 13-Stage Pipeline -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="inline-block mb-3">
          <span class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#3157FF] dark:text-[#6B82FF] font-semibold bg-[#3157FF]/10 dark:bg-[#6B82FF]/15 px-2.5 py-1 rounded">
            {project.category}
          </span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.1] mb-4">
          <a href={`/work/${project.slug}`} class="hover:text-[#3157FF] dark:hover:text-[#6B82FF] transition-colors focus:outline-none focus-visible:underline">
            {project.title}
          </a>
        </h2>

        <p class="text-[17px] text-[#111111] dark:text-[#F5F5F2] font-medium mb-3">
          Commercial-grade video campaigns powered by rigorous prompt architecture.
        </p>

        <p class="text-[15.5px] text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed mb-6">
          {project.description}
        </p>

        <!-- Two Commercial Formats Selection Tabs (Accessible Tablist) -->
        <div
          role="tablist"
          aria-label="Commercial campaign selection"
          class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs"
        >
          <button
            type="button"
            id="tabAdidasBtn"
            role="tab"
            aria-selected="true"
            aria-controls="playerWrapper"
            tabindex="0"
            class="px-3.5 py-2 rounded-md border border-[#111111] dark:border-[#F5F5F2] bg-[#111111] dark:bg-[#F5F5F2] text-white dark:text-[#111111] font-medium cursor-pointer transition-colors shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF]"
          >
            01 / ADIDAS SAMBA (9:16)
          </button>
          <button
            type="button"
            id="tabKreoBtn"
            role="tab"
            aria-selected="false"
            aria-controls="playerWrapper"
            tabindex="-1"
            class="px-3.5 py-2 rounded-md border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2] font-medium cursor-pointer transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF]"
          >
            02 / KREO TECH (16:9)
          </button>
        </div>

        <!-- The 13-Stage Pipeline Mini Visual -->
        <div class="mb-8 p-4 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] transition-colors">
          <div class="flex items-center justify-between text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase tracking-wider mb-2">
            <span>Verified 13-Stage Pipeline:</span>
            <span class="text-[#3157FF] dark:text-[#6B82FF] font-semibold">PROVEN WORKFLOW</span>
          </div>
          <div class="text-[12px] font-mono text-[#111111] dark:text-[#F5F5F2] leading-relaxed break-words">
            BRIEF → POSITIONING → 2K STORYBOARD → PROMPT ARCH → MULTI-SEED GEN → SELECTION GATE → EDITORIAL → SOUND DESIGN → QA MASTER
          </div>
        </div>

        <!-- Featured Campaigns Evidence -->
        <div class="space-y-2 mb-8 border-l-2 border-[#DCDCD8] dark:border-[#30302D] pl-4 text-xs sm:text-[13px] text-[#6B6B6B] dark:text-[#A3A3A0]">
          <div>• <strong>Adidas Samba</strong>: 9:16 vertical commercial reel with leather texture retention.</div>
          <div>• <strong>Kreo Tech</strong>: 16:9 widescreen narrative product commercial exploring mechanical hardware.</div>
          <div>• <strong>2K Storyboards</strong>: Strict focal length blocking before generative iterations.</div>
        </div>

        <!-- CTA Link -->
        <div>
          <a
            href={`/work/${project.slug}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] group transition-colors focus:outline-none focus-visible:underline"
          >
            <span>View Full Case Study &amp; Production Pipeline</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Dual Commercial Showcase with Lightweight Facade -->
      <div class="lg:col-span-7">
        <div class="relative rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xs">
          <!-- Frame Header -->
          <div class="px-4 py-2.5 bg-[#141416] border-b border-[#262628] flex items-center justify-between gap-3 text-xs font-mono text-[#8E8E93]">
            <div class="flex items-center gap-2 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full bg-[#EF4444] shrink-0"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B] shrink-0"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] shrink-0"></span>
              <span id="campaignTitleLabel" class="ml-2 text-white font-medium truncate">ADIDAS_SAMBA_COMMERCIAL_1080P</span>
            </div>
            <span id="campaignFormatLabel" class="tracking-wider shrink-0 text-[11px] sm:text-xs">9:16 COMMERCIAL REEL</span>
          </div>

          <!-- Campaign Player Stage (Fixed min-height avoids layout shift) -->
          <div class="relative bg-black flex items-center justify-center p-3 sm:p-6 min-h-[440px] sm:min-h-[520px]">
            <!-- Responsive Wrapper for YouTube Embed & Facade (WAI-ARIA tabpanel) -->
            <div
              id="playerWrapper"
              role="tabpanel"
              aria-labelledby="tabAdidasBtn"
              class="w-[250px] max-w-full sm:w-[300px] aspect-[9/16] rounded-lg overflow-hidden shadow-2xl bg-black relative transition-all duration-300 motion-reduce:transition-none"
            >
              <!-- Click-to-Play Facade (No iframe loaded on initial page load) -->
              <div
                id="videoFacade"
                class="absolute inset-0 z-10 w-full h-full flex flex-col items-center justify-center cursor-pointer group/facade select-none overflow-hidden"
              >
                <!-- High-Fidelity Poster Image -->
                <picture>
                  <source id="facadeWebp" srcset="/assets/projects/ai-ad-production/adidas-samba-poster.webp" type="image/webp" />
                  <img
                    id="facadePoster"
                    src="/assets/projects/ai-ad-production/adidas-samba-poster.jpg"
                    alt="Adidas Samba AI Commercial 1080p Master Poster"
                    class="absolute inset-0 w-full h-full object-cover brightness-95 group-hover/facade:scale-105 transition-transform duration-500 motion-reduce:transform-none"
                    loading="eager"
                    width="1376"
                    height="768"
                  />
                </picture>

                <!-- Subtle dark vignette gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/45 group-hover/facade:from-black/75 transition-colors"></div>

                <!-- Interactive Accessible Play Trigger -->
                <button
                  id="activateVideoBtn"
                  type="button"
                  class="relative z-20 flex flex-col items-center gap-3 p-4 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3157FF] dark:focus-visible:ring-[#6B82FF] rounded-2xl cursor-pointer"
                  aria-label="Play Adidas Samba Commercial"
                >
                  <!-- Play Icon Circle with Smooth Glow Effect -->
                  <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-black/60 backdrop-blur-md border border-white/25 flex items-center justify-center shadow-lg group-hover/facade:bg-[#3157FF] group-hover/facade:border-transparent group-hover/facade:scale-110 transition-all duration-300 motion-reduce:transition-none">
                    <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>

                  <!-- Status Badge -->
                  <div class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-[10.5px] font-mono tracking-wider uppercase text-white/90 group-hover/facade:text-white transition-colors">
                    <span>▶ LOAD 1080P MASTER</span>
                  </div>
                </button>

                <!-- Resolution / Quality Badge at Bottom -->
                <div class="absolute bottom-3 inset-x-3 flex items-center justify-between text-[10px] font-mono text-white/70 pointer-events-none">
                  <span class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
                    <span>STUDIO MASTER</span>
                  </span>
                  <span id="facadeAspectBadge">9:16 VERTICAL</span>
                </div>
              </div>

              <!-- Mount Point for Dynamic YouTube IFrame (Empty on initial load) -->
              <div id="iframeMount" class="w-full h-full"></div>
            </div>
          </div>

          <!-- Video Frame Action Bar -->
          <div class="px-4 py-3 bg-[#141416] border-t border-[#262628] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-white/80">
            <div class="flex items-center gap-3">
              <span class="text-[#8E8E93]">Direct In-Page Player</span>
              <span class="text-[#262628]">•</span>
              <span class="text-[#10B981]">1080p Masters</span>
            </div>
            <div class="flex items-center gap-3">
              <a
                href="/assets/projects/ai-ad-production/storyboard-samba.jpeg"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#3157FF] dark:text-[#6B82FF] hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-[#3157FF]"
              >
                [ Storyboard 2K ]
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Clean Commercial Switcher Controls with Zero Initial IFrame Overhead (Click-to-Play Facade)
  const playerWrapper = document.getElementById('playerWrapper');
  const videoFacade = document.getElementById('videoFacade');
  const activateVideoBtn = document.getElementById('activateVideoBtn');
  const iframeMount = document.getElementById('iframeMount');
  const facadePoster = document.getElementById('facadePoster') as HTMLImageElement | null;
  const facadeWebp = document.getElementById('facadeWebp') as HTMLSourceElement | null;
  const facadeAspectBadge = document.getElementById('facadeAspectBadge');
  const titleLabel = document.getElementById('campaignTitleLabel');
  const formatLabel = document.getElementById('campaignFormatLabel');
  const tabAdidas = document.getElementById('tabAdidasBtn');
  const tabKreo = document.getElementById('tabKreoBtn');

  interface CampaignData {
    id: string;
    title: string;
    format: string;
    aspectBadge: string;
    posterJpg: string;
    posterWebp: string;
    posterAlt: string;
    playLabel: string;
    wrapperClasses: string;
  }

  const campaigns: Record<'adidas' | 'kreo', CampaignData> = {
    adidas: {
      id: '4SVc4FL4Mdk',
      title: 'ADIDAS_SAMBA_COMMERCIAL_1080P',
      format: '9:16 COMMERCIAL REEL',
      aspectBadge: '9:16 VERTICAL',
      posterJpg: '/assets/projects/ai-ad-production/adidas-samba-poster.jpg',
      posterWebp: '/assets/projects/ai-ad-production/adidas-samba-poster.webp',
      posterAlt: 'Adidas Samba AI Commercial 1080p Master Poster',
      playLabel: 'Play Adidas Samba Commercial',
      wrapperClasses: 'w-[250px] max-w-full sm:w-[300px] aspect-[9/16] rounded-lg overflow-hidden shadow-2xl bg-black relative transition-all duration-300 motion-reduce:transition-none'
    },
    kreo: {
      id: 'cPhpFQnsXKo',
      title: 'KREO_TECH_COMMERCIAL_16X9',
      format: '16:9 WIDESCREEN FILM',
      aspectBadge: '16:9 WIDESCREEN',
      posterJpg: '/assets/projects/ai-ad-production/kreo-tech-poster.jpg',
      posterWebp: '/assets/projects/ai-ad-production/kreo-tech-poster.webp',
      posterAlt: 'Kreo Tech Commercial 1080p Master Poster',
      playLabel: 'Play Kreo Tech Commercial',
      wrapperClasses: 'w-full max-w-[620px] aspect-video rounded-lg overflow-hidden shadow-2xl bg-black relative transition-all duration-300 motion-reduce:transition-none'
    }
  };

  let activeKey: 'adidas' | 'kreo' = 'adidas';
  let isVideoPlaying = false;

  // Preconnect to YouTube CDN upon user interaction with facade/play button for zero-delay playback
  const preconnectYouTube = () => {
    if (document.querySelector('link[data-yt-preconnect]')) return;
    const link = document.createElement('link');
    link.rel = 'preconnect';
    link.href = 'https://www.youtube-nocookie.com';
    link.setAttribute('data-yt-preconnect', 'true');
    document.head.appendChild(link);
  };

  const loadActiveVideo = () => {
    if (!iframeMount) return;
    const data = campaigns[activeKey];
    isVideoPlaying = true;

    // Dynamically insert YouTube privacy-enhanced embed with autoplay
    iframeMount.innerHTML = `
      <iframe
        src="https://www.youtube-nocookie.com/embed/${data.id}?autoplay=1&rel=0"
        title="${data.title}"
        class="w-full h-full border-0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    `;

    if (videoFacade) {
      videoFacade.classList.add('hidden');
    }

    // Move keyboard focus smoothly into iframe player
    const iframe = iframeMount.querySelector('iframe');
    iframe?.focus();
  };

  const switchCampaign = (key: 'adidas' | 'kreo') => {
    if (activeKey === key || !playerWrapper) return;
    activeKey = key;

    const data = campaigns[key];
    playerWrapper.className = data.wrapperClasses;
    playerWrapper.setAttribute('aria-labelledby', key === 'adidas' ? 'tabAdidasBtn' : 'tabKreoBtn');

    if (titleLabel) titleLabel.textContent = data.title;
    if (formatLabel) formatLabel.textContent = data.format;
    if (facadeAspectBadge) facadeAspectBadge.textContent = data.aspectBadge;

    const activeClasses = ['border-[#111111]', 'dark:border-[#F5F5F2]', 'bg-[#111111]', 'dark:bg-[#F5F5F2]', 'text-white', 'dark:text-[#111111]'];
    const inactiveClasses = ['border-[#DCDCD8]', 'dark:border-[#30302D]', 'bg-white', 'dark:bg-[#181818]', 'text-[#6B6B6B]', 'dark:text-[#A3A3A0]'];

    if (key === 'adidas') {
      tabAdidas?.classList.remove(...inactiveClasses);
      tabAdidas?.classList.add(...activeClasses);
      tabAdidas?.setAttribute('aria-selected', 'true');
      tabAdidas?.setAttribute('tabindex', '0');

      tabKreo?.classList.remove(...activeClasses);
      tabKreo?.classList.add(...inactiveClasses);
      tabKreo?.setAttribute('aria-selected', 'false');
      tabKreo?.setAttribute('tabindex', '-1');
    } else {
      tabKreo?.classList.remove(...inactiveClasses);
      tabKreo?.classList.add(...activeClasses);
      tabKreo?.setAttribute('aria-selected', 'true');
      tabKreo?.setAttribute('tabindex', '0');

      tabAdidas?.classList.remove(...activeClasses);
      tabAdidas?.classList.add(...inactiveClasses);
      tabAdidas?.setAttribute('aria-selected', 'false');
      tabAdidas?.setAttribute('tabindex', '-1');
    }

    if (isVideoPlaying) {
      // If already playing, immediately load the new video
      loadActiveVideo();
    } else {
      // If not playing, update the facade poster and aria label
      if (facadePoster) {
        facadePoster.src = data.posterJpg;
        facadePoster.alt = data.posterAlt;
      }
      if (facadeWebp) {
        facadeWebp.srcset = data.posterWebp;
      }
      if (activateVideoBtn) {
        activateVideoBtn.setAttribute('aria-label', data.playLabel);
      }
    }
  };

  // Preconnect listeners
  if (videoFacade) {
    videoFacade.addEventListener('pointerenter', preconnectYouTube, { once: true });
    videoFacade.addEventListener('click', loadActiveVideo);
  }
  if (activateVideoBtn) {
    activateVideoBtn.addEventListener('focus', preconnectYouTube, { once: true });
    activateVideoBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      loadActiveVideo();
    });
  }

  // Tab switching clicks
  if (tabAdidas) tabAdidas.addEventListener('click', () => switchCampaign('adidas'));
  if (tabKreo) tabKreo.addEventListener('click', () => switchCampaign('kreo'));

  // Keyboard navigation for tablist (Left/Right/Home/End arrows per WAI-ARIA)
  const tabButtons = [tabAdidas, tabKreo].filter(Boolean) as HTMLButtonElement[];
  tabButtons.forEach((btn, idx) => {
    btn.addEventListener('keydown', (e) => {
      let targetIdx: number | null = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        targetIdx = (idx + 1) % tabButtons.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        targetIdx = (idx - 1 + tabButtons.length) % tabButtons.length;
      } else if (e.key === 'Home') {
        targetIdx = 0;
      } else if (e.key === 'End') {
        targetIdx = tabButtons.length - 1;
      }

      if (targetIdx !== null) {
        e.preventDefault();
        const targetBtn = tabButtons[targetIdx];
        targetBtn.focus();
        targetBtn.click();
      }
    });
  });
</script>
