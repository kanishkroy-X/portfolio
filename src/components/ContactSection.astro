---
import { siteMetadata } from '../data/siteMetadata';
---

<section id="contact" class="py-24 md:py-32 relative overflow-hidden transition-colors">
  <!-- Subtle blue ambient glow -->
  <div class="absolute bottom-0 left-1/3 w-[500px] h-[350px] bg-[radial-gradient(ellipse_at_center,_rgba(49,87,255,0.08)_0%,_rgba(247,247,245,0)_70%)] dark:bg-[radial-gradient(ellipse_at_center,_rgba(107,130,255,0.1)_0%,_rgba(17,17,17,0)_70%)] pointer-events-none -z-10"></div>

  <div class="max-w-[1320px] mx-auto px-6">
    <div class="max-w-3xl">
      <div class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] tracking-[0.2em] uppercase font-bold mb-3">
        07 // CONTACT &amp; COLLABORATION
      </div>

      <h2 class="text-3xl sm:text-5xl font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.1] mb-6">
        Let's build something real together.
      </h2>

      <p class="text-base sm:text-lg text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed mb-10">
        Whether you are engineering an edge application, building an AI-backed pipeline, or need creative direction for a brand video campaign, I am open to discussing new projects and technical advisory roles.
      </p>

      <!-- Primary Action: Start a conversation -->
      <div class="mb-12">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[#111111] dark:bg-[#F5F5F2] text-white dark:text-[#111111] text-base font-semibold hover:bg-[#3157FF] dark:hover:bg-[#6B82FF] hover:text-white transition-all duration-200 shadow-md group"
        >
          <span>START A CONVERSATION</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- Verified Channels Grid -->
      <div class="pt-10 border-t border-[#DCDCD8] dark:border-[#30302D] grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 text-xs font-mono">
        <!-- Direct Email -->
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">Direct Email</div>
          <a href={`mailto:${siteMetadata.email}`} class="text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] font-semibold break-all transition-colors">
            {siteMetadata.email}
          </a>
        </div>

        <!-- LinkedIn -->
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">LinkedIn Profile</div>
          <a href={siteMetadata.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] font-semibold transition-colors flex items-center gap-1">
            <span>Kanishk Roy</span>
            <span>↗</span>
          </a>
        </div>

        <!-- GitHub -->
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">GitHub Repositories</div>
          <a href={siteMetadata.social.github} target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] font-semibold transition-colors flex items-center gap-1">
            <span>@kanishkroy-X</span>
            <span>↗</span>
          </a>
        </div>

        <!-- X -->
        <div>
          <div class="text-[#8E8E93] dark:text-[#777774] uppercase mb-1">X / Twitter</div>
          <a href={siteMetadata.social.x} target="_blank" rel="noopener noreferrer" class="text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] font-semibold transition-colors flex items-center gap-1">
            <span>@kanishkroy_</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
