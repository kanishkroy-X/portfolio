---
import { siteMetadata } from '../data/siteMetadata';
---

<section id="contact" class="py-20 md:py-28 transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="max-w-3xl">
      <div class="text-xs font-mono tracking-[0.24em] uppercase text-[#315CFF] font-bold mb-3">
        06 // CONTACT
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight leading-[1.05] mb-8 font-mono">
        LET'S MAKE SOMETHING.
      </h2>

      <!-- Minimal Primary CTA -->
      <div class="mb-14">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="inline-flex items-center gap-2.5 px-8 py-4 rounded-md bg-[#111111] dark:bg-[#F3F1EC] text-[#F3F1EC] dark:text-[#111111] text-xs font-mono font-bold tracking-[0.16em] uppercase hover:bg-[#315CFF] dark:hover:bg-[#315CFF] hover:text-white dark:hover:text-white transition-all duration-200"
        >
          <span>GET IN TOUCH</span>
          <span class="text-sm">→</span>
        </a>
      </div>

      <!-- Professional Links -->
      <div class="pt-8 border-t border-[#D3D0C9] dark:border-[#26272B] flex flex-wrap items-center gap-6 sm:gap-8 text-xs font-mono">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          {siteMetadata.email} ↗
        </a>
        <a
          href={siteMetadata.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href={siteMetadata.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          GitHub ↗
        </a>
        <a
          href={siteMetadata.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          X (Twitter) ↗
        </a>
        <a
          href={siteMetadata.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] transition-colors"
        >
          YouTube ↗
        </a>
      </div>
    </div>
  </div>
</section>
