---
import { productProjects } from '../data/projects';

const project = productProjects.find(p => p.id === 'randomchat')!;
---

<section id="product-systems" class="py-16 md:py-20 border-b border-[#D3D0C9] dark:border-[#26272B] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <!-- Section Heading -->
    <div class="mb-10">
      <div class="text-xs font-mono tracking-[0.24em] uppercase text-[#315CFF] font-bold mb-2">
        02 // PRODUCT / AI SYSTEMS
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight">
        Systems Architecture &amp; Product Implementation
      </h2>
      <p class="text-sm sm:text-base text-[#555555] dark:text-[#A0A09B] mt-1 font-sans">
        Proof of product thinking, UX, systems thinking, interaction design, and distributed execution.
      </p>
    </div>

    <!-- Compact Feature Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Media: UI Screenshot -->
      <div class="lg:col-span-7">
        <a
          href={`/work/${project.slug}`}
          class="block group relative rounded-lg border border-[#D3D0C9] dark:border-[#26272B] bg-[#0D0E10] overflow-hidden shadow-sm hover:border-[#111111] dark:hover:border-[#F3F1EC] transition-all"
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-[#0D0E10]">
            <img
              src="/assets/projects/randomchat/randomchat-ui.png"
              alt="RandomChat real-time anonymous chat interface"
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>

            <div class="absolute top-3 left-3 flex items-center gap-2 px-2.5 py-1 rounded bg-black/80 backdrop-blur-md border border-white/10 text-[10px] font-mono text-white">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              <span>LIVE EDGE SYSTEM</span>
            </div>
          </div>

          <div class="p-3 bg-[#151619] border-t border-[#26272B] flex items-center justify-between text-[11px] font-mono text-[#A0A09B]">
            <span>Cloudflare Workers + Durable Objects + WebSockets</span>
            <span class="text-white group-hover:text-[#315CFF] transition-colors">VIEW SYSTEM →</span>
          </div>
        </a>
      </div>

      <!-- Compact Details -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <div class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#315CFF] font-semibold mb-2">
          {project.category}
        </div>

        <h3 class="text-2xl sm:text-3xl font-bold text-[#111111] dark:text-[#F3F1EC] mb-3">
          <a href={`/work/${project.slug}`} class="hover:text-[#315CFF] transition-colors">
            {project.title}
          </a>
        </h3>

        <p class="text-sm text-[#555555] dark:text-[#A0A09B] leading-relaxed mb-5 font-sans">
          {project.shortDescription}
        </p>

        <!-- Architectural Systems Specification -->
        <div class="border-y border-[#D3D0C9] dark:border-[#26272B] divide-y divide-[#D3D0C9]/50 dark:divide-[#26272B]/70 mb-8 text-xs font-mono">
          <div class="py-2.5 flex items-center justify-between">
            <span class="text-[#7B8798] text-[10.5px] uppercase tracking-wider">01 // PRODUCT</span>
            <span class="text-[#111111] dark:text-[#F3F1EC] font-semibold text-right">Frictionless Anonymous UX</span>
          </div>
          <div class="py-2.5 flex items-center justify-between">
            <span class="text-[#7B8798] text-[10.5px] uppercase tracking-wider">02 // SYSTEMS</span>
            <span class="text-[#111111] dark:text-[#F3F1EC] font-semibold text-right">Zero-DB Durable Objects</span>
          </div>
          <div class="py-2.5 flex items-center justify-between">
            <span class="text-[#7B8798] text-[10.5px] uppercase tracking-wider">03 // INTERACTION</span>
            <span class="text-[#111111] dark:text-[#F3F1EC] font-semibold text-right">Mutual Consent Audio</span>
          </div>
          <div class="py-2.5 flex items-center justify-between">
            <span class="text-[#7B8798] text-[10.5px] uppercase tracking-wider">04 // ARCHITECTURE</span>
            <span class="text-[#111111] dark:text-[#F3F1EC] font-semibold text-right">Edge WebSockets</span>
          </div>
        </div>

        <div>
          <a
            href={`/work/${project.slug}`}
            class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-[0.14em] uppercase text-[#111111] dark:text-[#F3F1EC] hover:text-[#315CFF] group transition-colors"
          >
            <span>VIEW CASE STUDY</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
