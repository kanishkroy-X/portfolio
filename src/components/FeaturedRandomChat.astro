---
import { projects } from '../data/projects';

const project = projects.find(p => p.id === 'randomchat')!;
---

<section id="featured-work" class="py-20 md:py-28 border-b border-[#DCDCD8] dark:border-[#30302D] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <!-- Section Eyebrow -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] tracking-[0.2em] uppercase">
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-bold">01 // FEATURED SYSTEM</span>
        <span class="text-[#DCDCD8] dark:text-[#30302D]">/</span>
        <span>TECHNICAL PILLAR</span>
      </div>
      <span class="text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase">PRODUCTION DEPLOYMENT</span>
    </div>

    <!-- Main Feature Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Left Column: Media & Architecture -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <a href={`/work/${project.slug}`} class="block group relative rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-[#0E0E10] overflow-hidden shadow-xs hover:border-[#3157FF] dark:hover:border-[#6B82FF] transition-all duration-300">
          <!-- Main Product Screenshot -->
          <div class="relative aspect-[16/10] overflow-hidden bg-[#161618]">
            <img
              src="/assets/projects/randomchat/randomchat-ui.png"
              alt="RandomChat Dark Mode Interface showing people lobby and live chat"
              class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>

            <!-- Overlay Badge -->
            <div class="absolute top-4 left-4 flex items-center gap-2 px-3 py-1.5 rounded-md bg-black/80 backdrop-blur-md border border-white/10 text-[11px] font-mono text-white">
              <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
              <span>LIVE EDGE SYSTEM</span>
            </div>

            <!-- Bottom Preview Pills -->
            <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-white/90">
              <span class="bg-black/60 backdrop-blur px-2.5 py-1 rounded">REAL-TIME SOCKETS</span>
              <span class="text-white/70">ZERO PERSISTENT DATA</span>
            </div>
          </div>

          <!-- Architecture Visual Drawer under preview -->
          <div class="p-4 sm:p-5 bg-[#121214] border-t border-[#262628] flex items-center justify-between text-xs font-mono text-[#8E8E93]">
            <div class="flex items-center gap-2">
              <span class="text-[#3157FF] dark:text-[#6B82FF]">CF WORKERS</span>
              <span>→</span>
              <span class="text-white">DURABLE OBJECTS</span>
              <span>→</span>
              <span class="text-[#3157FF] dark:text-[#6B82FF]">WEBSOCKETS</span>
            </div>
            <span class="text-[#6B6B6B] group-hover:text-white transition-colors">EXPLORE ARCHITECTURE →</span>
          </div>
        </a>
      </div>

      <!-- Right Column: Project Context & Impact -->
      <div class="lg:col-span-5 order-1 lg:order-2 flex flex-col">
        <div class="inline-block mb-3">
          <span class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#3157FF] dark:text-[#6B82FF] font-semibold bg-[#3157FF]/10 dark:bg-[#6B82FF]/15 px-2.5 py-1 rounded">
            {project.category}
          </span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight leading-[1.1] mb-4">
          <a href={`/work/${project.slug}`} class="hover:text-[#3157FF] dark:hover:text-[#6B82FF] transition-colors">
            {project.title}
          </a>
        </h2>

        <p class="text-[17px] text-[#111111] dark:text-[#F5F5F2] font-medium mb-3">
          Real-time anonymous communication on the edge.
        </p>

        <p class="text-[15.5px] text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed mb-6">
          {project.description}
        </p>

        <!-- Technical Tags Grid -->
        <div class="mb-8">
          <div class="text-[11px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0] uppercase tracking-wider mb-2.5">
            Core Technologies &amp; Runtime:
          </div>
          <div class="flex flex-wrap gap-2">
            {project.technologies.map(tech => (
              <span class="text-xs font-mono px-2.5 py-1 rounded border border-[#DCDCD8] dark:border-[#30302D] bg-white dark:bg-[#181818] text-[#111111] dark:text-[#F5F5F2]">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Key Engineering Decisions -->
        <div class="space-y-2 mb-8 border-l-2 border-[#DCDCD8] dark:border-[#30302D] pl-4 text-xs sm:text-[13px] text-[#6B6B6B] dark:text-[#A3A3A0]">
          <div>• In-memory room isolation with Cloudflare Durable Objects.</div>
          <div>• Ephemeral guest sessions without account fatigue or tracking.</div>
          <div>• Progressive mutual-consent WebRTC voice request unlock.</div>
        </div>

        <!-- CTA Link -->
        <div>
          <a
            href={`/work/${project.slug}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#111111] dark:text-[#F5F5F2] hover:text-[#3157FF] dark:hover:text-[#6B82FF] group transition-colors"
          >
            <span>View Full Case Study &amp; Architecture</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
