---
const steps = [
  {
    icon: '/assets/icons/icon-build.svg',
    title: 'BUILD',
    subtitle: 'Production Rigor',
    description: 'Deconstruct ideas into clean architecture, resilient code, and verifiable edge primitives.'
  },
  {
    icon: '/assets/icons/icon-experiment.svg',
    title: 'EXPERIMENT',
    subtitle: 'Rapid Prototyping',
    description: 'Test hypotheses through functional prototypes rather than theoretical slide decks.'
  },
  {
    icon: '/assets/icons/icon-ai-systems.svg',
    title: 'AI SYSTEMS',
    subtitle: 'Deterministic Grounding',
    description: 'Harness generative models with strict prompt architecture and automated verifier gates.'
  },
  {
    icon: '/assets/icons/icon-create.svg',
    title: 'CREATE',
    subtitle: 'Art Direction',
    description: 'Blend technical engineering with cinematic storytelling, audio foley, and editorial design.'
  },
  {
    icon: '/assets/icons/icon-improve.svg',
    title: 'IMPROVE',
    subtitle: 'Data & CRO Feedback',
    description: 'Continuously measure drop-offs, optimize latency, and refine conversion funnels.'
  },
  {
    icon: '/assets/icons/icon-share.svg',
    title: 'SHARE',
    subtitle: 'Open & Transparent',
    description: 'Document architecture openly, ship real code to GitHub, and build in public.'
  }
];
---

<section class="py-20 md:py-28 border-b border-[#DCDCD8] dark:border-[#30302D] relative overflow-hidden transition-colors">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 opacity-40 dark:opacity-20 pointer-events-none bg-[radial-gradient(#111111_0.75px,_transparent_0.75px)] dark:bg-[radial-gradient(#F5F5F2_0.75px,_transparent_0.75px)] [background-size:24px_24px]"></div>

  <div class="max-w-[1320px] mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-14">
      <div class="max-w-2xl">
        <div class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] tracking-[0.2em] uppercase font-bold mb-2">
          04 // OPERATIONAL PHILOSOPHY
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight mb-4">
          How I Work
        </h2>
        <p class="text-base sm:text-lg text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
          A continuous loop between analytical systems thinking and sensory creative craft. No unnecessary layers. Direct hands-on execution from first commit to production deployment.
        </p>
      </div>
      <!-- Decorative Technical Grid Element -->
      <div class="hidden lg:block opacity-60 dark:opacity-40">
        <img
          src="/assets/editorial/grid-element.svg"
          alt="Technical Grid Element"
          class="w-48 h-auto dark:invert"
        />
      </div>
    </div>

    <!-- 6-Stage Icon Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {steps.map((step, idx) => (
        <div class="p-6 sm:p-8 rounded-xl border border-[#DCDCD8] dark:border-[#30302D] bg-white/80 dark:bg-[#181818]/90 hover:bg-white dark:hover:bg-[#202020] hover:border-[#3157FF]/60 dark:hover:border-[#6B82FF]/60 hover:shadow-xs transition-all duration-300 relative group">
          <!-- Step Index -->
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-lg bg-[#F7F7F5] dark:bg-[#141416] border border-[#DCDCD8] dark:border-[#30302D] flex items-center justify-center group-hover:border-[#3157FF]/40 dark:group-hover:border-[#6B82FF]/40 transition-colors">
              <img src={step.icon} alt={step.title} class="w-6 h-6 text-[#111111] dark:invert" />
            </div>
            <span class="font-mono text-xs text-[#8E8E93] dark:text-[#777774]">0{idx + 1}</span>
          </div>

          <!-- Step Content -->
          <h3 class="text-lg font-bold text-[#111111] dark:text-[#F5F5F2] tracking-tight mb-1">
            {step.title}
          </h3>
          <div class="text-xs font-mono text-[#3157FF] dark:text-[#6B82FF] mb-3">
            {step.subtitle}
          </div>
          <p class="text-sm text-[#6B6B6B] dark:text-[#A3A3A0] leading-relaxed">
            {step.description}
          </p>

          <!-- Subtle Corner Registration Point -->
          <div class="absolute bottom-2 right-2 text-[9px] font-mono text-[#DCDCD8] dark:text-[#30302D] group-hover:text-[#3157FF] dark:group-hover:text-[#6B82FF] transition-colors">
            +
          </div>
        </div>
      ))}
    </div>

    <!-- Editorial Note Graphic -->
    <div class="mt-14 pt-8 border-t border-[#DCDCD8] dark:border-[#30302D] flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[#6B6B6B] dark:text-[#A3A3A0] transition-colors">
      <div class="flex items-center gap-2">
        <span class="text-[#111111] dark:text-[#F5F5F2] font-semibold">FORMULA:</span>
        <span>DECONSTRUCT</span>
        <span>→</span>
        <span class="text-[#3157FF] dark:text-[#6B82FF] font-semibold">BUILD</span>
        <span>→</span>
        <span>TEST</span>
        <span>→</span>
        <span class="text-[#111111] dark:text-[#F5F5F2] font-semibold">REFINE</span>
      </div>
      <span>NO SAAS TEMPLATES • HANDMADE CRAFT</span>
    </div>
  </div>
</section>
