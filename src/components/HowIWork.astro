---
const steps = [
  {
    number: '01',
    title: 'CONCEPT',
    description: 'Deconstruct brand intent into a core narrative angle, hook mechanics, and pacing script.'
  },
  {
    number: '02',
    title: 'REFERENCE',
    description: 'Lock visual codes, lighting setups, 2K camera blocking, and multi-view consistency sheets.'
  },
  {
    number: '03',
    title: 'GENERATE',
    description: 'Decoupled prompt token synthesis across top models with a strict 5% artifact curation gate.'
  },
  {
    number: '04',
    title: 'EDIT / REFINE',
    description: 'Frame-accurate timeline conform in Premiere Pro with tactile Foley sound design and color grading.'
  }
];
---

<section id="how-i-work" class="py-20 md:py-28 border-b border-[#D3D0C9] dark:border-[#26272B] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6">
    <div class="mb-14">
      <div class="text-xs font-mono tracking-[0.24em] uppercase text-[#315CFF] font-bold mb-3">
        05 // HOW I WORK
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#111111] dark:text-[#F3F1EC] tracking-tight mb-3">
        Disciplined Production Framework
      </h2>
      <p class="text-base text-[#555555] dark:text-[#A0A09B] max-w-xl font-sans">
        A four-stage method turning creative intent into broadcast-grade commercial output.
      </p>
    </div>

    <!-- 4-Stage Connected Editorial Framework -->
    <div class="border-y border-[#D3D0C9] dark:border-[#26272B] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-[#D3D0C9] dark:divide-[#26272B]">
      {steps.map((step, idx) => (
        <div class={`py-8 ${idx === 0 ? 'sm:pr-6 lg:pr-8' : idx === 3 ? 'sm:pl-6 lg:pl-8' : 'sm:px-6 lg:px-8'} flex flex-col justify-between group`}>
          <div>
            <div class="text-xs font-mono text-[#315CFF] font-bold mb-4 tracking-wider">
              {step.number} //
            </div>
            <h3 class="text-xl font-bold font-mono text-[#111111] dark:text-[#F3F1EC] tracking-tight mb-3">
              {step.title}
            </h3>
            <p class="text-sm text-[#555555] dark:text-[#A0A09B] leading-relaxed font-sans">
              {step.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[#D3D0C9]/40 dark:border-[#26272B]/60 text-[10px] font-mono text-[#7B8798] uppercase tracking-widest">
            STAGE {step.number}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
