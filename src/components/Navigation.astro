---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/#ai-content', label: 'AI CONTENT' },
  { href: '/work', label: 'WORK' },
  { href: '/#about', label: 'ABOUT' },
  { href: '/#contact', label: 'CONTACT' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#F3F1EC]/90 dark:bg-[#0D0E10]/90 border-b border-[#D3D0C9] dark:border-[#26272B] transition-colors">
  <div class="max-w-[1320px] mx-auto px-6 h-18 flex items-center justify-between">
    <!-- Brand -->
    <a
      href="/"
      class="text-[13px] font-mono font-bold tracking-[0.2em] uppercase text-[#111111] dark:text-[#F3F1EC] hover:opacity-75 transition-opacity"
      aria-label="Kanishk Roy Portfolio"
    >
      KANISHK ROY
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8">
      <nav class="flex items-center gap-7" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isWorkActive = link.href === '/work' && currentPath.startsWith('/work');
          return (
            <a
              href={link.href}
              class={`text-[12px] font-mono tracking-[0.16em] uppercase transition-colors py-1 ${
                isWorkActive
                  ? 'text-[#111111] dark:text-[#F3F1EC] font-bold border-b border-[#111111] dark:border-[#F3F1EC]'
                  : 'text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Theme Switcher -->
      <ThemeToggle />
    </div>

    <!-- Mobile Navigation Toggle -->
    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="mobileMenuToggle"
        class="text-[12px] font-mono font-bold tracking-[0.16em] uppercase px-3 py-1.5 border border-[#D3D0C9] dark:border-[#26272B] rounded bg-white/50 dark:bg-[#151619] text-[#111111] dark:text-[#F3F1EC] focus:outline-none focus-visible:ring-1 focus-visible:ring-[#315CFF]"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        MENU
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobileMenu"
    class="hidden md:hidden border-b border-[#D3D0C9] dark:border-[#26272B] bg-[#F3F1EC] dark:bg-[#0D0E10] px-6 py-6 transition-colors"
  >
    <nav class="flex flex-col gap-4 font-mono text-sm tracking-[0.18em] uppercase" aria-label="Mobile Navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-[#555555] dark:text-[#A0A09B] hover:text-[#111111] dark:hover:text-[#F3F1EC] py-2 border-b border-[#D3D0C9]/40 dark:border-[#26272B]/50 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      toggleBtn.textContent = isExpanded ? 'MENU' : 'CLOSE';
    });

    links.forEach((l) => {
      l.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.textContent = 'MENU';
      });
    });
  }
</script>
