---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#F7F7F5]/90 dark:bg-[#111111]/90 border-b border-[#DCDCD8]/80 dark:border-[#30302D]/80 transition-colors">
  <div class="max-w-[1320px] mx-auto px-6 h-18 flex items-center justify-between">
    <!-- Brand Monogram -->
    <a href="/" class="group flex items-center gap-2.5 text-[#111111] dark:text-[#F5F5F2] hover:opacity-80 transition-opacity" aria-label="Kanishk Roy Home">
      <div class="flex items-center">
        <!-- Geometric KR Monogram -->
        <svg class="h-6 w-auto" viewBox="0 0 76 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g fill="currentColor">
            <rect x="4" y="8" width="6" height="32" rx="0.5"/>
            <polygon points="25,8 11,23.5 11,25 25.5,40 17.5,40 7.5,28 7.5,21 17.5,8"/>
            <rect x="30" y="8" width="6" height="32" rx="0.5"/>
            <path d="M33 8H45C50.5 8 54 11.5 54 16.5C54 21.5 50.5 25 45 25H36V8ZM36 14V19.5H44.5C47 19.5 48.5 18.2 48.5 16.5C48.5 14.8 47 14 44.5 14H36Z" fill-rule="evenodd"/>
            <polygon points="42,23 54.5,40 47.5,40 37,25 42,23"/>
          </g>
          <circle cx="64" cy="24" r="3.5" class="fill-[#3157FF] dark:fill-[#6B82FF]"/>
        </svg>
      </div>
      <span class="hidden sm:inline-block font-mono text-[11px] text-[#6B6B6B] dark:text-[#A3A3A0] tracking-[0.2em] uppercase font-semibold border-l border-[#DCDCD8] dark:border-[#30302D] pl-3">
        Studio
      </span>
    </a>

    <!-- Center Studio Status Pill (Desktop) -->
    <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full border border-[#DCDCD8] dark:border-[#30302D] bg-white/70 dark:bg-[#181818]/80 text-[11.5px] font-mono text-[#6B6B6B] dark:text-[#A3A3A0]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3157FF] dark:bg-[#6B82FF] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#3157FF] dark:bg-[#6B82FF]"></span>
      </span>
      <span>Available for Q4 Product &amp; AI Systems</span>
    </div>

    <!-- Navigation Links & Theme Switcher -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="flex items-center gap-4 sm:gap-7" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`relative text-[13.5px] font-medium tracking-wide transition-colors py-1 ${
                isActive
                  ? 'text-[#111111] dark:text-[#F5F5F2] font-semibold'
                  : 'text-[#6B6B6B] dark:text-[#A3A3A0] hover:text-[#111111] dark:hover:text-[#F5F5F2]'
              }`}
            >
              {link.label}
              {isActive && (
                <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#3157FF] dark:bg-[#6B82FF]" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Primary CTA button in Nav -->
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-[12px] font-mono font-medium text-white dark:text-[#111111] bg-[#111111] dark:bg-[#F5F5F2] hover:bg-[#3157FF] dark:hover:bg-[#6B82FF] hover:text-white rounded-md transition-all duration-200"
      >
        <span>Let's Talk</span>
        <span class="text-xs">→</span>
      </a>
    </div>
  </div>
</header>
